# Contoh konfigurasi aplikasi; salin menjadi .env lalu sesuaikan nilainya
PORT=3000
# Host server PostgreSQL
DB_HOST=localhost
# Port server PostgreSQL
DB_PORT=5432
# Nama pengguna PostgreSQL
DB_USER=postgres
# Kata sandi PostgreSQL (isi dengan milik Anda, jangan diunggah)
DB_PASSWORD=isi_password_anda
# Nama database yang dipakai aplikasi
DB_NAME=bura_db
# Akun admin untuk HTTP Basic Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat
# Batas ukuran unggahan foto dalam megabyte
UPLOAD_MAKS_FOTO_MB=5
# Batas ukuran unggahan video dalam megabyte
UPLOAD_MAKS_VIDEO_MB=80
# Kunci API Gemini dari Google AI Studio (jangan pernah diunggah)
GEMINI_API_KEY=isi_api_key_anda
# Nama model Gemini yang dipakai, misalnya dari daftar model Flash
GEMINI_MODEL=isi_nama_model_flash
# Batas waktu permintaan Gemini dalam milidetik
GEMINI_TIMEOUT_MS=15000
# Batas jumlah pertanyaan chatbot per IP per menit
CHAT_BATAS_PER_MENIT=10
# Batas jumlah pertanyaan chatbot per IP per hari
CHAT_BATAS_PER_HARI=100
# Batas jumlah pertanyaan chatbot untuk seluruh pengunjung per hari
CHAT_BATAS_GLOBAL_PER_HARI=500
# Batas jumlah pembuatan caption admin per menit
CAPTION_BATAS_PER_MENIT=10
