    </symbol>
    <symbol id="ikon-daun" viewBox="0 0 24 24">
      <path d="M19 5c-7.5.4-12 4.2-12 9.2 0 2.2 1.6 3.8 3.8 3.8C15.8 18 19 13.5 19 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M5 20c2.2-4.2 5.2-7.2 9-9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
