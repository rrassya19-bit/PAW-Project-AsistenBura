<%
  const kategoriMenu = [];

  daftarProduk.forEach(function (produk) {
    const kategori = kategoriMenu.find(function (item) {
      return item.nama === produk.kategori;
    });

    if (kategori) {
      kategori.produk.push(produk);
    } else {
      kategoriMenu.push({ nama: produk.kategori, produk: [produk] });
    }
  });

  function buatSlug(teks) {
    return String(teks)
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  const ikonKategori = {
    'Espresso & Filter Coffee': 'ikon-espresso',
    'Coffee Milk Based': 'ikon-susu',
    'Coffee Non Milk Based': 'ikon-jeruk',
    'Non Coffee': 'ikon-daun',
    'Tea & Others': 'ikon-teh',
    'Additional': 'ikon-tambah'
  };

  kategoriMenu.forEach(function (kategori, indeks) {
    kategori.id = 'kategori-' + (buatSlug(kategori.nama) || 'menu') + '-' + (indeks + 1);
    kategori.jumlah = kategori.produk.length;
    kategori.ikon = ikonKategori[kategori.nama] || 'ikon-cangkir';
  });

  function mediaUrl(nama) {
    return '/media/' + encodeURIComponent(nama).replace(/'/g, '%27');
  }

  const heroStaticNama = 'Kenalin, ini Bura Bura Headquarters. Cabang terbaru Bura Bura yang terletak di dekat titik nol7 Y.jpg';

