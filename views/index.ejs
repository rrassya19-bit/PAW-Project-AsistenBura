      <path d="M5 9h11v5a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M9 6l1.5-2M12 6l1.5-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </symbol>
    <symbol id="ikon-tambah" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6" />
      <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </symbol>
    <symbol id="ikon-cangkir" viewBox="0 0 24 24">
      <path d="M5 9h10v5.2A4.8 4.8 0 0 1 10.2 19h-.4A4.8 4.8 0 0 1 5 14.2V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M15 10h1.6a2.4 2.4 0 0 1 0 4.8H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </symbol>
  </svg>

  <a class="skip-link" href="#menu">Lewati ke menu</a>

  <header class="site-header" data-header>
    <div class="container nav-shell">
      <a class="brand" href="#atas" aria-label="<%= namaKafe %>, kembali ke awal halaman">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="9" fill="#002FA7" />
            <rect x="6" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <rect x="18" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <circle cx="10" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="10" cy="19" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="19" r="1.4" fill="#002FA7" />
          </svg>
        </span>
        <span class="brand__text">
          <span class="brand__name"><%= namaKafe %></span>
          <span class="brand__app"><%= appName %></span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Navigasi utama">
        <a class="nav-link" href="#menu" data-nav>Menu</a>
        <a class="nav-link" href="#galeri" data-nav>Galeri</a>
      </nav>
    </div>
    <div class="progress" aria-hidden="true"><span class="progress__bar" data-progress></span></div>
  </header>

  <main id="konten">
    <section id="atas" class="hero" data-hero aria-labelledby="judul-hero">
      <div class="hero__bg" data-hero-bg aria-hidden="true">
        <div class="hero__static">
          <img
            src="<%= heroStatic.src %>"
            alt=""
            width="1080"
            height="1350"
            fetchpriority="high"
            decoding="async"
            data-hero-static
          />
        </div>
        <div class="hero__track" data-hero-track>
          <% heroPhotos.concat(heroPhotos).forEach(function (foto) { %>
            <span class="hero__slide">
              <img data-src="<%= foto.src %>" alt="" width="1080" height="1350" loading="lazy" decoding="async" />
            </span>
          <% }); %>
        </div>
        <div class="hero__veil"></div>
      </div>

      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow reveal"><%= namaKafe %></p>
          <h1 id="judul-hero" class="hero__title reveal" style="--delay: 90ms;">Kopi untuk harimu.</h1>
          <p class="hero__sub reveal" style="--delay: 180ms;">Lihat menu dan harga terbaru.</p>
          <div class="hero__actions reveal" style="--delay: 270ms;">
            <a class="btn btn--primary" href="#menu">Lihat Menu</a>
            <a class="btn btn--ghost" href="#galeri">Galeri</a>
          </div>
        </div>

        <div class="hero__collage" role="group" aria-label="Sorotan foto <%= namaKafe %>">
          <% collagePhotos.forEach(function (foto, indeks) { %>
            <figure class="hero__card hero__card--<%= indeks + 1 %>" style="--delay: <%= 160 + indeks * 80 %>ms;">
              <span class="hero__card-frame">
                <img
                  src="<%= foto.src %>"
                  alt="<%= foto.alt %>"
                  width="1080"
                  height="1350"
                  loading="<%= indeks === 0 ? 'eager' : 'lazy' %>"
                  decoding="async"
                />
              </span>
            </figure>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="menu" class="menu" aria-labelledby="judul-menu">
      <div class="container">
        <header class="section-head">
          <div>
            <p class="eyebrow reveal">Daftar</p>
            <h2 id="judul-menu" class="section-head__title reveal" style="--delay: 60ms;">Menu</h2>
          </div>
          <p class="section-head__sub reveal" style="--delay: 120ms;"><%= daftarProduk.length %> pilihan menu.</p>
        </header>

        <% if (daftarProduk.length === 0) { %>
          <p class="menu-empty">Belum ada menu.</p>
        <% } else { %>
          <nav class="menu-pills reveal" style="--delay: 120ms;" aria-label="Kategori menu">
            <div class="menu-pills__track" data-pill-track>
              <span class="menu-pills__indicator" data-pill-indicator aria-hidden="true"></span>
              <% kategoriMenu.forEach(function (kategori, indeks) { %>
                <a
                  class="menu-pill"
                  href="#<%= kategori.id %>"
                  data-kategori-link="<%= kategori.id %>"
                  <% if (indeks === 0) { %>aria-current="true"<% } %>
                ><%= kategori.nama %></a>
              <% }); %>
            </div>
          </nav>

          <div class="menu-list">
            <% kategoriMenu.forEach(function (kategori) { %>
              <section
                id="<%= kategori.id %>"
                class="menu-group<%= kategori.nama === 'Additional' ? ' menu-group--compact' : '' %>"
                data-kategori-section
                aria-labelledby="judul-<%= kategori.id %>"
              >
                <header class="menu-group__head reveal">
                  <span class="menu-group__icon" aria-hidden="true">
                    <svg><use href="#<%= kategori.ikon %>"></use></svg>
                  </span>
                  <h3 id="judul-<%= kategori.id %>" class="menu-group__title"><%= kategori.nama %></h3>
                  <span class="menu-group__count"><%= kategori.jumlah %> pilihan</span>
                </header>

                <div class="menu-grid">
                  <% kategori.produk.forEach(function (produk, indeks) { %>
                    <article class="menu-item<%= produk.tersedia ? '' : ' menu-item--out' %> reveal" style="--delay: <%= Math.min(indeks, 5) * 40 %>ms;">
                      <div class="menu-item__top">
                        <h4 class="menu-item__name"><%= produk.nama %></h4>
                        <p class="menu-item__price">
                          <% if (produk.hargaMaks != null && produk.hargaMaks > produk.harga) { %>
                            <%= formatRupiah(produk.harga) %> &ndash; <%= formatRupiah(produk.hargaMaks) %>
                          <% } else { %>
                            <%= formatRupiah(produk.harga) %>
                          <% } %>
                        </p>
                      </div>
                      <p class="menu-item__desc"><%= produk.deskripsi %></p>
                      <% if (!produk.tersedia) { %>
                        <span class="menu-item__badge">Habis</span>
                      <% } %>
                    </article>
                  <% }); %>
                </div>
              </section>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>

    <section id="galeri" class="gallery" aria-labelledby="judul-galeri">
      <div class="container">
        <header class="section-head">
          <div>
            <p class="eyebrow reveal">Foto</p>
            <h2 id="judul-galeri" class="section-head__title reveal" style="--delay: 60ms;">Galeri</h2>
          </div>
          <p class="section-head__sub reveal" style="--delay: 120ms;">Foto dan cuplikan <%= namaKafe %>.</p>
        </header>

        <div class="gallery__grid">
          <% galleryPhotos.forEach(function (foto, indeks) { %>
            <a
              class="gallery__item reveal"
              href="<%= foto.src %>"
              data-galeri-index="<%= indeks %>"
              data-src="<%= foto.src %>"
              data-alt="<%= foto.alt %>"
              style="--delay: <%= (indeks % 4) * 60 %>ms;"
              aria-label="Buka foto <%= indeks + 1 %> dari <%= galleryPhotos.length %>"
            >
              <img src="<%= foto.src %>" alt="<%= foto.alt %>" width="1080" height="1350" loading="lazy" decoding="async" />
              <span class="gallery__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </a>
          <% }); %>
        </div>

        <div class="gallery__videos">
          <div class="gallery__video-head">
            <h3 class="gallery__video-title reveal">Cuplikan</h3>
          </div>

          <div class="video-grid">
            <% galleryVideos.forEach(function (video, indeks) { %>
              <article class="video-card reveal" style="--delay: <%= indeks * 80 %>ms;" data-video-card>
                <div class="video-card__frame">
                  <video
                    data-video
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster="<%= video.posterSrc %>"
                    aria-label="Cuplikan <%= namaKafe %>"
                  >
                    <source src="<%= video.src %>" type="video/mp4" />
                  </video>
                  <button class="video-card__toggle" type="button" data-video-toggle aria-label="Putar cuplikan">
                    <svg class="video-card__icon video-card__icon--play" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M8 5.5v13l10-6.5-10-6.5Z" fill="currentColor" />
                    </svg>
                    <svg class="video-card__icon video-card__icon--pause" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="7" y="5" width="3.5" height="14" rx="1" fill="currentColor" />
                      <rect x="13.5" y="5" width="3.5" height="14" rx="1" fill="currentColor" />
                    </svg>
                  </button>
                  <span class="video-card__error" hidden>Video tidak tersedia</span>
                </div>
              </article>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer" data-waktu="<%= waktuTerformat %>">
    <div class="container footer__inner">
      <div class="footer__brand">
        <span class="footer__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="9" fill="#002FA7" />
            <rect x="6" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <rect x="18" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <circle cx="10" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="10" cy="19" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="19" r="1.4" fill="#002FA7" />
          </svg>
        </span>
        <span class="footer__text">
          <span class="footer__name"><%= namaKafe %></span>
          <span class="footer__app"><%= appName %></span>
        </span>
      </div>

      <p class="footer__status" data-status aria-live="polite">
        <span class="status-dot" aria-hidden="true"></span>
        <span data-status-text>Memeriksa...</span>
      </p>
    </div>
  </footer>

  <dialog class="lightbox" data-lightbox aria-label="Galeri foto <%= namaKafe %>">
    <div class="lightbox__panel">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Tutup galeri">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>

      <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Foto sebelumnya">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <figure class="lightbox__figure">
        <img data-lightbox-img alt="" decoding="async" draggable="false" />
      </figure>

      <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Foto berikutnya">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <p class="lightbox__caption" data-lightbox-caption aria-live="polite"></p>
    </div>
  </dialog>

  <script>
    (function () {
      'use strict';

      var doc = document;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      var saveData = !!(connection && connection.saveData);
      var header = doc.querySelector('[data-header]');
      var progress = doc.querySelector('[data-progress]');
      var hero = doc.querySelector('[data-hero]');
      var heroBg = doc.querySelector('[data-hero-bg]');
      var heroTrack = doc.querySelector('[data-hero-track]');
      var heroStatic = doc.querySelector('[data-hero-static]');
      var navLinks = Array.prototype.slice.call(doc.querySelectorAll('[data-nav]'));
      var revealItems = Array.prototype.slice.call(doc.querySelectorAll('.reveal'));

      function revealAll() {
        revealItems.forEach(function (item) {
          item.classList.add('is-visible');
        });
      }

      if ('IntersectionObserver' in window && !reduceMotion.matches) {
        var revealObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { threshold: 0.01, rootMargin: '0px 0px -8% 0px' });

        revealItems.forEach(function (item) {
          revealObserver.observe(item);
        });
      } else {
        revealAll();
      }

      if (heroStatic) {
        heroStatic.addEventListener('error', function () {
          if (heroBg) heroBg.classList.add('is-error');
        });
      }

      if (heroTrack && !saveData && !reduceMotion.matches) {
        var loadTrack = function () {
          var images = heroTrack.querySelectorAll('img[data-src]');

          Array.prototype.forEach.call(images, function (img) {
            img.src = img.getAttribute('data-src');
            img.removeAttribute('data-src');
          });

          heroTrack.classList.add('is-ready');
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadTrack, { timeout: 1800 });
        } else {
          window.setTimeout(loadTrack, 700);
        }
      }

      var ticking = false;

      function updateScroll() {
        ticking = false;

        var y = window.scrollY || window.pageYOffset || 0;

        if (header) {
          header.classList.toggle('is-scrolled', y > 8);
        }

        if (progress) {
          var max = doc.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = 'scaleX(' + (max > 0 ? Math.min(y / max, 1) : 0) + ')';
        }

        if (heroBg && hero && !reduceMotion.matches) {
          var rect = hero.getBoundingClientRect();
          var p = Math.min(Math.max(-rect.top / Math.max(rect.height, 1), 0), 1);
          heroBg.style.setProperty('--hero-shift', (p * 24).toFixed(1) + 'px');
        }
      }

      function requestScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateScroll);
      }

      window.addEventListener('scroll', requestScroll, { passive: true });
      window.addEventListener('resize', requestScroll);
      updateScroll();

      if (hero) {
        var px = 0;
        var py = 0;
        var pointerFrame = 0;
        var finePointer = window.matchMedia('(pointer: fine)');

        hero.addEventListener('pointermove', function (event) {
          if (reduceMotion.matches || !finePointer.matches) return;

          var rect = hero.getBoundingClientRect();
          px = ((event.clientX - rect.left) / Math.max(rect.width, 1) - 0.5) * 18;
          py = ((event.clientY - rect.top) / Math.max(rect.height, 1) - 0.5) * 18;

          if (!pointerFrame) {
            pointerFrame = window.requestAnimationFrame(function () {
              pointerFrame = 0;
              hero.style.setProperty('--px', px.toFixed(1) + 'px');
              hero.style.setProperty('--py', py.toFixed(1) + 'px');
            });
          }
        }, { passive: true });

        hero.addEventListener('pointerleave', function () {
          px = 0;
          py = 0;

          if (!pointerFrame) {
            pointerFrame = window.requestAnimationFrame(function () {
              pointerFrame = 0;
              hero.style.setProperty('--px', '0px');
              hero.style.setProperty('--py', '0px');
            });
          }
        });
      }

      if ('IntersectionObserver' in window && navLinks.length) {
        var navSections = navLinks.map(function (link) {
          return doc.querySelector(link.getAttribute('href'));
        }).filter(Boolean);

        var navObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            navLinks.forEach(function (link) {
              if (link.getAttribute('href') === '#' + entry.target.id) {
                link.setAttribute('aria-current', 'true');
              } else {
                link.removeAttribute('aria-current');
              }
            });
          });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

        navSections.forEach(function (section) {
          navObserver.observe(section);
        });
      }

      var pillTrack = doc.querySelector('[data-pill-track]');
      var pillIndicator = doc.querySelector('[data-pill-indicator]');
      var pills = Array.prototype.slice.call(doc.querySelectorAll('[data-kategori-link]'));
      var activePill = pills[0] || null;

      function moveIndicator(link) {
        if (!pillTrack || !pillIndicator || !link) return;

        var trackRect = pillTrack.getBoundingClientRect();
        var linkRect = link.getBoundingClientRect();
        var x = linkRect.left - trackRect.left + pillTrack.scrollLeft - pillTrack.clientLeft;

        pillIndicator.style.width = linkRect.width + 'px';
        pillIndicator.style.transform = 'translateX(' + x + 'px)';
      }

      function setActivePill(link) {
        if (!link) return;

        activePill = link;

        pills.forEach(function (pill) {
          if (pill === link) {
            pill.setAttribute('aria-current', 'true');
          } else {
            pill.removeAttribute('aria-current');
          }
        });

        moveIndicator(link);
      }

      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          setActivePill(pill);
        });
      });

      if (activePill) {
        window.requestAnimationFrame(function () {
          moveIndicator(activePill);
        });

        window.addEventListener('resize', function () {
          moveIndicator(activePill);
        });

        if (doc.fonts && doc.fonts.ready) {
          doc.fonts.ready.then(function () {
            moveIndicator(activePill);
          });
        }
      }

      if ('IntersectionObserver' in window && pills.length) {
        var pillSections = pills.map(function (pill) {
          return doc.querySelector(pill.getAttribute('href'));
        }).filter(Boolean);

        var pillObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            var link = pills.find(function (pill) {
              return pill.getAttribute('href') === '#' + entry.target.id;
            });

            if (link) setActivePill(link);
          });
        }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });

        pillSections.forEach(function (section) {
          pillObserver.observe(section);
        });
      }

      var galleryImages = Array.prototype.slice.call(doc.querySelectorAll('.gallery__item img'));

      galleryImages.forEach(function (img) {
        var loaded = function () {
          img.classList.add('is-loaded');
        };

        var failed = function () {
          img.classList.add('is-error');
          img.classList.add('is-loaded');
        };

        if (img.complete) {
          if (img.naturalWidth) loaded();
          else failed();
        } else {
          img.addEventListener('load', loaded, { once: true });
          img.addEventListener('error', failed, { once: true });
        }
      });

      var galleryDialog = doc.querySelector('[data-lightbox]');
      var galleryItems = Array.prototype.slice.call(doc.querySelectorAll('[data-galeri-index]'));
      var galleryImage = galleryDialog ? galleryDialog.querySelector('[data-lightbox-img]') : null;
      var galleryCaption = galleryDialog ? galleryDialog.querySelector('[data-lightbox-caption]') : null;
      var galleryIndex = 0;
      var galleryTrigger = null;

      function showGallery(index) {
        if (!galleryItems.length || !galleryImage) return;

        galleryIndex = (index + galleryItems.length) % galleryItems.length;

        var item = galleryItems[galleryIndex];

        galleryImage.classList.remove('is-error');
        galleryImage.src = item.getAttribute('data-src');
        galleryImage.alt = item.getAttribute('data-alt') || '';

        if (galleryCaption) {
          galleryCaption.textContent = 'Foto ' + (galleryIndex + 1) + ' dari ' + galleryItems.length;
        }
      }

      function openGallery(index, trigger) {
        if (!galleryDialog || typeof galleryDialog.showModal !== 'function') return;

        galleryTrigger = trigger || null;
        showGallery(index);
        galleryDialog.showModal();
        doc.body.classList.add('lightbox-open');

        var closeButton = galleryDialog.querySelector('[data-lightbox-close]');

        if (closeButton) closeButton.focus();
      }

      function closeGallery() {
        if (galleryDialog && galleryDialog.open) galleryDialog.close();
      }

      galleryItems.forEach(function (item) {
        item.addEventListener('click', function (event) {
          if (!galleryDialog || typeof galleryDialog.showModal !== 'function') return;

          event.preventDefault();
          openGallery(parseInt(item.getAttribute('data-galeri-index'), 10), item);
        });
      });

      if (galleryDialog) {
        var closeButton = galleryDialog.querySelector('[data-lightbox-close]');
        var prevButton = galleryDialog.querySelector('[data-lightbox-prev]');
        var nextButton = galleryDialog.querySelector('[data-lightbox-next]');
        var figure = galleryDialog.querySelector('.lightbox__figure');
        var startX = null;

        if (closeButton) {
          closeButton.addEventListener('click', closeGallery);
        }

        if (prevButton) {
          prevButton.addEventListener('click', function () {
            showGallery(galleryIndex - 1);
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', function () {
            showGallery(galleryIndex + 1);
          });
        }

        if (galleryImage) {
          galleryImage.addEventListener('load', function () {
            galleryImage.classList.remove('is-error');
          });

          galleryImage.addEventListener('error', function () {
            galleryImage.classList.add('is-error');

            if (galleryCaption) {
              galleryCaption.textContent = 'Foto tidak tersedia';
            }
          });
        }

        galleryDialog.addEventListener('close', function () {
          doc.body.classList.remove('lightbox-open');

          if (galleryTrigger) {
            galleryTrigger.focus();
            galleryTrigger = null;
          }
        });

        galleryDialog.addEventListener('click', function (event) {
          if (event.target === galleryDialog) closeGallery();
        });

        galleryDialog.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            showGallery(galleryIndex - 1);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            showGallery(galleryIndex + 1);
          } else if (event.key === 'Tab') {
            var focusables = Array.prototype.slice.call(galleryDialog.querySelectorAll('button')).filter(function (button) {
              return !button.disabled && button.offsetParent !== null;
            });

            if (!focusables.length) return;

            var first = focusables[0];
            var last = focusables[focusables.length - 1];

            if (event.shiftKey && doc.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && doc.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        if (figure) {
          figure.addEventListener('pointerdown', function (event) {
            startX = event.clientX;
          });

          figure.addEventListener('pointerup', function (event) {
            if (startX === null) return;

            var distance = event.clientX - startX;
            startX = null;

            if (Math.abs(distance) < 40) return;

            showGallery(galleryIndex + (distance < 0 ? 1 : -1));
          });

          figure.addEventListener('pointercancel', function () {
            startX = null;
          });
        }
      }

      var videos = Array.prototype.slice.call(doc.querySelectorAll('[data-video]'));

      function updateVideoCard(video) {
        var card = video.closest('[data-video-card]');
        if (!card) return;

        var button = card.querySelector('[data-video-toggle]');
        var playing = !video.paused && !video.ended;

        card.classList.toggle('is-playing', playing);

        if (button) {
          button.setAttribute('aria-label', playing ? 'Jeda cuplikan' : 'Putar cuplikan');
        }
      }

      function playVideo(video) {
        videos.forEach(function (other) {
          if (other !== video && !other.paused) other.pause();
        });

        var promise = video.play();

        if (promise && typeof promise.catch === 'function') {
          promise.catch(function () {});
        }
      }

      videos.forEach(function (video) {
        var card = video.closest('[data-video-card]');
        var button = card ? card.querySelector('[data-video-toggle]') : null;

        if (button) {
          button.addEventListener('click', function () {
            if (video.paused) {
              delete video.dataset.userPaused;
              playVideo(video);
            } else {
              video.dataset.userPaused = 'true';
              video.pause();
            }
          });
        }

        video.addEventListener('play', function () {
          updateVideoCard(video);
        });

        video.addEventListener('pause', function () {
          updateVideoCard(video);
        });

        video.addEventListener('ended', function () {
          updateVideoCard(video);
        });

        var failVideo = function () {
          if (card) card.classList.add('is-error');

          var message = card ? card.querySelector('.video-card__error') : null;

          if (message) message.hidden = false;

          video.pause();
        };

        video.addEventListener('error', failVideo);

        var source = video.querySelector('source');

        if (source) source.addEventListener('error', failVideo);
      });

      if ('IntersectionObserver' in window && videos.length && !reduceMotion.matches && !saveData) {
        var videoObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var video = entry.target;

            if (entry.isIntersecting && !doc.hidden && !video.dataset.userPaused) {
              playVideo(video);
            } else {
              video.pause();
            }
          });
        }, { threshold: 0.55 });

        videos.forEach(function (video) {
          videoObserver.observe(video);
        });
      }

      doc.addEventListener('visibilitychange', function () {
        if (doc.hidden) {
          videos.forEach(function (video) {
            video.pause();
          });
        }
      });

      var status = doc.querySelector('[data-status]');
      var statusText = doc.querySelector('[data-status-text]');

      if (status && statusText) {
        fetch('/api/status', { headers: { Accept: 'application/json' } })
          .then(function (response) {
            if (!response.ok) throw new Error('status');
            return response.json();
          })
          .then(function (data) {
            var online = data && data.status === 'aktif';

            status.classList.toggle('is-online', online);
            status.classList.toggle('is-offline', !online);
            statusText.textContent = online ? 'Terhubung' : 'Tidak terhubung';
          })
          .catch(function () {
            status.classList.add('is-offline');
            statusText.textContent = 'Tidak terhubung';
          });
      }

      if (reduceMotion.addEventListener) {
        reduceMotion.addEventListener('change', function () {
          if (reduceMotion.matches) {
            revealAll();

            videos.forEach(function (video) {
              video.pause();
            });

            if (hero) {
              hero.style.setProperty('--px', '0px');
              hero.style.setProperty('--py', '0px');
            }
          }

          requestScroll();
        });
      }

      updateScroll();
    })();
  </script>
</body>
</html>
