<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= judul %> - <%= appName %></title>

  <!-- Tailwind CSS lewat CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-stone-50 text-stone-800 antialiased">

  <!-- Header -->
  <header class="border-b border-stone-200 bg-amber-900 text-amber-50">
    <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs uppercase tracking-widest text-amber-200"><%= appName %></p>
        <h1 class="text-2xl font-bold"><%= namaKafe %></h1>
      </div>

      <!-- Lencana status server, diisi lewat fetch -->
      <div class="flex items-center gap-2 rounded-full bg-amber-800/60 px-3 py-1.5 text-sm text-amber-100">
        <span class="h-2 w-2 rounded-full bg-amber-300"></span>
        <span>Status server:</span>
        <span id="status-server" aria-live="polite" class="font-semibold">Memeriksa...</span>
      </div>
    </div>
  </header>

  <!-- Konten utama -->
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="mb-6">
      <h2 class="text-xl font-bold text-stone-900 sm:text-2xl">Menu Kami</h2>
      <p class="mt-1 text-sm text-stone-600">
        Pilihan kopi, minuman non-kopi, dan makanan ringan di <%= namaKafe %>.
      </p>
      <p class="mt-1 text-xs text-stone-500">Diperbarui: <%= waktuTerformat %></p>
    </section>

    <% if (daftarProduk.length === 0) { %>
      <!-- Tampilan jika data menu kosong -->
      <p class="rounded-xl border border-dashed border-stone-300 bg-white p-6 text-center text-stone-500">
        Belum ada menu.
      </p>
    <% } else { %>
      <!-- Daftar menu: 1 kolom di ponsel, lebih banyak di layar lebar -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% daftarProduk.forEach(function (produk) { %>
          <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <div class="mb-3 flex items-center justify-between gap-2">
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">
                <%= produk.kategori %>
              </span>
              <% if (!produk.tersedia) { %>
                <span class="text-xs font-semibold text-red-600">Habis</span>
              <% } %>
            </div>

            <h3 class="text-lg font-bold text-stone-900"><%= produk.nama %></h3>
            <p class="mt-1 flex-1 text-sm leading-relaxed text-stone-600"><%= produk.deskripsi %></p>

            <p class="mt-4 text-base font-bold text-amber-900"><%= formatRupiah(produk.harga) %></p>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-200 py-6 text-center text-xs text-stone-500">
    <%= namaKafe %> &middot; <%= appName %>
  </footer>

  <script>
    // Cek status server lewat API, lalu perbarui lencana
    async function cekStatusServer() {
      const badge = document.getElementById('status-server');

      try {
        const response = await fetch('/api/status');
        if (!response.ok) throw new Error('Server tidak merespons');

        await response.json();
        badge.textContent = 'Terhubung';
        badge.classList.add('text-emerald-200');
      } catch (error) {
        badge.textContent = 'Tidak terhubung';
        badge.classList.add('text-red-200');
      }
    }

    cekStatusServer();
  </script>
</body>
</html>
