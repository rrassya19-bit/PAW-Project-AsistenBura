  const galleryVideos = [
    {
      nama: 'Craving a coffee thats both smooth and bold Say hello to the Dirty Latte, now available at Bura.mp4',
      poster: 'Energi pagi bareng @uburuburlari & @parashit.sc di Mangkubumi kemarin emang beda. Senang seka7li.jpg'
