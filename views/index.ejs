  const galleryPhotos = [
    'Apa yang lebih enak dari nyeruput magic, dirty latte, atau kopi lainnyaMenyeruput kopi favorit d2.jpg',
    'Energi pagi bareng @uburuburlari & @parashit.sc di Mangkubumi kemarin emang beda. Senang seka7li.jpg',
