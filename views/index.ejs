    'Morning light hits the Mangkubumi corner just right. There is something incredibly peaceful abou3.jpg',
    'Morning light hits the Mangkubumi corner just right. There is something incredibly peaceful abou4.jpg',
    'Morning light hits the Mangkubumi corner just right. There is something incredibly peaceful abou5.jpg',
    'Sunlight, shadows, and a Montblanc. There is something about the way the citrus oils from the ze1.jpg'
  ].map(function (nama, indeks) {
    return { nama: nama, src: mediaUrl(nama), alt: 'Foto Bura Bura Coffee', indeks: indeks };
