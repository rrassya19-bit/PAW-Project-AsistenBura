<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= judul %> - <%= appName %></title>
  <meta name="description" content="Menu dan galeri Bura Bura Coffee." />
  <meta name="theme-color" content="#002FA7" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23002FA7'/%3E%3Crect x='6' y='9' width='8' height='14' rx='2' fill='%23FFFFFF'/%3E%3Crect x='18' y='9' width='8' height='14' rx='2' fill='%23FFFFFF'/%3E%3Ccircle cx='10' cy='13' r='1.4' fill='%23002FA7'/%3E%3Ccircle cx='10' cy='19' r='1.4' fill='%23002FA7'/%3E%3Ccircle cx='22' cy='13' r='1.4' fill='%23002FA7'/%3E%3Ccircle cx='22' cy='19' r='1.4' fill='%23002FA7'/%3E%3C/svg%3E" />
  <script>document.documentElement.classList.add('js');</script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />

  <style>
    :root {
      --cobalt: #002FA7;
      --cobalt-bright: #2A63FF;
      --navy: #060E2B;
      --paper: #FAF9F6;
      --white: #FFFFFF;
      --muted: #4A5470;
      --line: #E5E2DA;
      --paper-soft: #F3F1EA;
      --glass: rgba(250, 249, 246, 0.82);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --nav-h: 68px;
      --container: 1400px;
      --shadow: 0 30px 80px -52px rgba(6, 14, 43, 0.5);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    html,
    body {
      overflow-x: clip;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: var(--paper);
      color: var(--navy);
      font-family: "Plus Jakarta Sans", "Segoe UI", system-ui, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body,
    h1,
    h2,
    h3,
    h4,
    p,
    figure,
    blockquote,
    dl,
    dd {
      margin: 0;
    }

    ul,
    ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img,
    svg,
    video {
      display: block;
      max-width: 100%;
    }

    button {
      font: inherit;
    }

    ::selection {
      background: #CFE0FF;
      color: var(--navy);
    }

    :focus-visible {
      outline: 3px solid var(--cobalt-bright);
      outline-offset: 3px;
    }

    section[id] {
      scroll-margin-top: calc(var(--nav-h) + 24px);
    }

    .icon-sprite {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    .container {
      width: min(var(--container), calc(100% - 48px));
      margin-inline: auto;
    }

    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .skip-link {
      position: fixed;
      top: 8px;
      left: 8px;
      z-index: 100;
      padding: 11px 16px;
      border-radius: 6px;
      background: var(--cobalt);
      color: var(--white);
      font-size: 0.84rem;
      font-weight: 700;
      transform: translateY(-160%);
      transition: transform 0.2s var(--ease);
    }

    .skip-link:focus {
      transform: none;
    }

    .eyebrow {
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .js .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
      transition-delay: var(--delay, 0ms);
    }

    .js .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    .site-header {
      position: fixed;
      inset: 0 0 auto;
      z-index: 60;
      color: var(--white);
      transition: background-color 0.3s var(--ease), color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    }

    .site-header.is-scrolled {
      background: var(--glass);
      color: var(--navy);
      box-shadow: 0 18px 40px -36px rgba(6, 14, 43, 0.5);
    }

    @supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
      .site-header.is-scrolled {
        -webkit-backdrop-filter: blur(18px) saturate(1.2);
        backdrop-filter: blur(18px) saturate(1.2);
      }
    }

    .nav-shell {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      height: var(--nav-h);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .brand__mark {
      width: 34px;
      height: 34px;
      flex: none;
      overflow: hidden;
      border-radius: 9px;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
    }

    .brand__mark svg {
      width: 100%;
      height: 100%;
    }

    .brand__text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      line-height: 1.05;
    }

    .brand__name {
      font-family: "Fraunces", Georgia, serif;
      font-size: 1.06rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .brand__app {
      margin-top: 3px;
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.63rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      transition: color 0.3s var(--ease);
    }

    .site-header.is-scrolled .brand__app {
      color: var(--muted);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 13px;
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      transition: color 0.2s, background-color 0.2s;
    }

    .nav-link:hover,
    .nav-link[aria-current="true"] {
      background: rgba(255, 255, 255, 0.1);
      color: var(--white);
    }

    .site-header.is-scrolled .nav-link {
      color: var(--muted);
    }

    .site-header.is-scrolled .nav-link:hover,
    .site-header.is-scrolled .nav-link[aria-current="true"] {
      background: rgba(0, 47, 167, 0.06);
      color: var(--cobalt);
    }

    .progress {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 2px;
      background: transparent;
    }

    .progress__bar {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--cobalt-bright);
      transform: scaleX(0);
      transform-origin: 0 50%;
      will-change: transform;
    }

    .hero {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding: calc(var(--nav-h) + 44px) 0 76px;
      overflow: hidden;
      isolation: isolate;
      background: var(--navy);
      color: var(--white);
    }

    .hero__bg {
      position: absolute;
      inset: -6% 0;
      z-index: -2;
      overflow: hidden;
      background: var(--navy);
      transform: translate3d(0, calc(var(--hero-shift, 0px) * -1), 0);
      will-change: transform;
    }

    .hero__bg.is-error {
      background: linear-gradient(145deg, var(--navy), var(--cobalt));
    }

    .hero__static,
    .hero__track {
      position: absolute;
      inset: 0;
    }

    .hero__static img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 42%;
      filter: blur(30px) saturate(1.06);
      transform: scale(1.14);
      opacity: 0.74;
    }

    .hero__track {
      display: flex;
      width: max-content;
      height: 100%;
      opacity: 0;
      animation: heroMarquee 72s linear infinite;
      transition: opacity 0.9s ease;
      will-change: transform;
    }

    .hero__track.is-ready {
      opacity: 0.62;
    }

    .hero__slide {
      position: relative;
      flex: 0 0 33.333vw;
      height: 100%;
    }

    .hero__slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 40%;
      filter: blur(28px) saturate(1.1);
      opacity: 0;
      transform: scale(1.16);
      transition: opacity 0.7s ease;
      animation: heroPulse 18s ease-in-out infinite alternate;
    }

    .hero__slide img[src] {
      opacity: 1;
    }

    .hero__slide:nth-child(2n) img {
      animation-delay: -6s;
    }

    .hero__slide:nth-child(3n) img {
      animation-delay: -11s;
    }

    .hero__veil {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 74% 28%, rgba(42, 99, 255, 0.22), transparent 42%),
        linear-gradient(180deg, rgba(6, 14, 43, 0.55) 0%, rgba(6, 14, 43, 0.68) 46%, rgba(6, 14, 43, 0.95) 100%);
    }

    .hero__inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      align-items: center;
      gap: clamp(40px, 6vw, 96px);
    }

    .hero__copy {
      max-width: 620px;
    }

    .hero__eyebrow {
      color: rgba(255, 255, 255, 0.64);
    }

    .hero__title {
      max-width: 10ch;
      margin-top: 18px;
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(3rem, 7vw, 6.4rem);
      font-weight: 600;
      line-height: 0.92;
      letter-spacing: -0.055em;
      text-wrap: balance;
    }

    .hero__sub {
      max-width: 34ch;
      margin-top: 24px;
      color: rgba(255, 255, 255, 0.76);
      font-size: clamp(1rem, 1.3vw, 1.12rem);
      line-height: 1.7;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 34px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 21px;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      transition: transform 0.2s var(--ease), background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn--primary {
      background: var(--cobalt-bright);
      color: var(--white);
      box-shadow: 0 14px 32px -18px rgba(42, 99, 255, 0.9);
    }

    .btn--primary:hover {
      background: var(--white);
      color: var(--cobalt);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.24);
      background: rgba(255, 255, 255, 0.04);
      color: var(--white);
    }

    .btn--ghost:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .hero__collage {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: clamp(10px, 1.4vw, 18px);
      width: 100%;
      max-width: 620px;
      justify-self: end;
    }

    .hero__card {
      --rot: -3deg;
      --depth: 0.6;
      position: relative;
      margin: 0;
      opacity: 0;
      transform: translate3d(calc(var(--px, 0px) * var(--depth)), calc(var(--py, 0px) * var(--depth)), 0) rotate(var(--rot));
      animation: heroCardIn 0.8s var(--ease) forwards;
      animation-delay: var(--delay, 0ms);
      transition: transform 0.45s var(--ease);
    }

    .hero__card:nth-child(1) {
      --rot: -4deg;
      margin-top: 8%;
    }

    .hero__card:nth-child(2) {
      --rot: 3deg;
      --depth: 1;
      margin-top: -4%;
    }

    .hero__card:nth-child(3) {
      --rot: 2deg;
      --depth: 0.8;
      margin-top: -8%;
    }

    .hero__card:nth-child(4) {
      --rot: -2deg;
      --depth: 1.1;
      margin-top: 4%;
    }

    .hero__card-frame {
      display: block;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 18px;
      background: #0B1C4A;
      box-shadow: 0 30px 70px -34px rgba(0, 0, 0, 0.85);
      animation: heroFloat 7s ease-in-out infinite alternate;
    }

    .hero__card:nth-child(1) .hero__card-frame {
      aspect-ratio: 4 / 5;
      animation-duration: 6.4s;
      animation-delay: -1s;
    }

    .hero__card:nth-child(2) .hero__card-frame {
      aspect-ratio: 3 / 4;
      animation-duration: 7.6s;
      animation-delay: -2.2s;
    }

    .hero__card:nth-child(3) .hero__card-frame {
      aspect-ratio: 3 / 4;
      animation-duration: 8.2s;
      animation-delay: -3.4s;
    }

    .hero__card:nth-child(4) .hero__card-frame {
      aspect-ratio: 4 / 5;
      animation-duration: 7s;
      animation-delay: -0.6s;
    }

    .hero__card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @keyframes heroMarquee {
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    @keyframes heroPulse {
      from {
        transform: scale(1.12) translate3d(0, 0, 0);
      }
      to {
        transform: scale(1.2) translate3d(-1.5%, -1%, 0);
      }
    }

    @keyframes heroFloat {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, -10px, 0);
      }
    }

    @keyframes heroCardIn {
      to {
        opacity: 1;
      }
    }

    .menu {
      padding: clamp(76px, 9vw, 124px) 0 clamp(80px, 10vw, 132px);
      background: var(--paper);
    }

    .section-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 24px;
      margin-bottom: clamp(28px, 4vw, 48px);
    }

    .section-head__title {
      margin-top: 10px;
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(2.2rem, 4vw, 3.8rem);
      font-weight: 600;
      line-height: 0.96;
      letter-spacing: -0.045em;
    }

    .section-head__sub {
      max-width: 36ch;
      justify-self: end;
      color: var(--muted);
      line-height: 1.7;
    }

    .menu-pills {
      position: sticky;
      top: calc(var(--nav-h) + 10px);
      z-index: 20;
      margin-bottom: 22px;
      padding: 10px 0 14px;
      background: linear-gradient(180deg, var(--paper) 72%, rgba(250, 249, 246, 0));
    }

    .menu-pills__track {
      position: relative;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      padding: 4px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.74);
      scrollbar-width: none;
    }

    .menu-pills__track::-webkit-scrollbar {
      display: none;
    }

    @supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
      .menu-pills__track {
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
    }

    .menu-pill {
      position: relative;
      z-index: 1;
      display: inline-flex;
      flex: none;
      align-items: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 999px;
      color: var(--muted);
      font-size: 0.77rem;
      font-weight: 700;
      white-space: nowrap;
      transition: color 0.2s;
    }

    .menu-pill:hover {
      color: var(--cobalt);
    }

    .menu-pill[aria-current="true"] {
      color: var(--white);
    }

    .menu-pills__indicator {
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 0;
      width: 0;
      border-radius: 999px;
      background: var(--cobalt);
      opacity: 0;
      transition: transform 0.3s var(--ease), width 0.3s var(--ease);
    }

    .js .menu-pills__indicator {
      opacity: 1;
    }

    .menu-list {
      display: flex;
      flex-direction: column;
      gap: clamp(36px, 5vw, 64px);
    }

    .menu-group {
      scroll-margin-top: calc(var(--nav-h) + 86px);
    }

    .menu-group__head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
    }

    .menu-group__icon {
      display: grid;
      flex: none;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(0, 47, 167, 0.08);
      color: var(--cobalt);
    }

    .menu-group__icon svg {
      width: 20px;
      height: 20px;
    }

    .menu-group__title {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(1.35rem, 2.2vw, 1.8rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .menu-group__count {
      margin-left: auto;
      color: var(--muted);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 0 clamp(28px, 4vw, 64px);
    }

    .menu-item {
      padding: 22px 0;
      border-bottom: 1px solid var(--line);
    }

    .menu-item__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
    }

    .menu-item__name {
      font-family: "Fraunces", Georgia, serif;
      font-size: 1.12rem;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.015em;
    }

    .menu-item__price {
      margin-left: auto;
      color: var(--cobalt);
      font-size: 0.9rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .menu-item__desc {
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.6;
    }

    .menu-item--out .menu-item__name {
      color: var(--muted);
    }

    .menu-item__badge {
      display: inline-block;
      margin-top: 8px;
      color: var(--cobalt);
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .menu-group--compact .menu-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .menu-group--compact .menu-item {
      padding: 16px 0;
    }

    .menu-group--compact .menu-item__desc {
      display: none;
    }

    .menu-empty {
      padding: 40px 0;
      color: var(--muted);
    }

    .gallery {
      padding: clamp(76px, 9vw, 124px) 0;
      border-top: 1px solid var(--line);
      background: var(--white);
    }

    .gallery__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(10px, 1.4vw, 18px);
    }

    .gallery__item {
      position: relative;
      display: block;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 12px;
      background: var(--navy);
    }

    .gallery__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.55s var(--ease), filter 0.4s ease;
    }

    .js .gallery__item img {
      filter: blur(12px);
    }

    .js .gallery__item img.is-loaded {
      filter: none;
    }

    .gallery__item img.is-error {
      opacity: 0;
    }

    .gallery__item::after {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 55%, rgba(6, 14, 43, 0.4));
      content: "";
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .gallery__zoom {
      position: absolute;
      right: 12px;
      bottom: 12px;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.94);
      color: var(--navy);
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.25s ease, transform 0.25s var(--ease);
    }

    .gallery__zoom svg {
      width: 16px;
      height: 16px;
    }

    .gallery__item:focus-visible {
      outline: 3px solid var(--cobalt-bright);
      outline-offset: 3px;
    }

    @media (hover: hover) {
      .gallery__item:hover img {
        transform: scale(1.045);
      }

      .gallery__item:hover::after,
      .gallery__item:hover .gallery__zoom,
      .gallery__item:focus-visible .gallery__zoom {
        opacity: 1;
        transform: none;
      }
    }

    .gallery__videos {
      margin-top: clamp(56px, 7vw, 96px);
    }

    .gallery__video-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
    }

    .gallery__video-title {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(1.5rem, 2.4vw, 2rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(12px, 2vw, 24px);
    }

    .video-card {
      min-width: 0;
    }

    .video-card__frame {
      position: relative;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border-radius: 14px;
      background: var(--navy);
    }

    .video-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .video-card__toggle {
      position: absolute;
      left: 12px;
      bottom: 12px;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.94);
      color: var(--cobalt);
      cursor: pointer;
      box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.6);
      transition: transform 0.2s var(--ease), background-color 0.2s;
    }

    .video-card__toggle:hover {
      background: var(--white);
      transform: scale(1.04);
    }

    .video-card__toggle:focus-visible {
      outline: 3px solid var(--white);
      outline-offset: 3px;
      box-shadow: 0 0 0 6px rgba(6, 14, 43, 0.55);
    }

    .video-card__icon {
      width: 18px;
      height: 18px;
    }

    .video-card__icon--pause {
      display: none;
    }

    .video-card.is-playing .video-card__icon--play {
      display: none;
    }

    .video-card.is-playing .video-card__icon--pause {
      display: block;
    }

    .video-card__error {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: var(--navy);
      color: var(--white);
      font-size: 0.82rem;
      text-align: center;
    }

    .video-card__error[hidden] {
      display: none;
    }

    .video-card.is-error video,
    .video-card.is-error .video-card__toggle {
      display: none;
    }

    .lightbox:not([open]) {
      display: none;
    }

    .lightbox {
      width: min(94vw, 1080px);
      max-width: 1080px;
      max-height: 92svh;
      margin: auto;
      padding: 0;
      border: 0;
      border-radius: 18px;
      background: rgba(6, 14, 43, 0.97);
      color: var(--white);
      box-shadow: 0 30px 90px -30px rgba(0, 0, 0, 0.8);
    }

    .lightbox::backdrop {
      background: rgba(2, 6, 20, 0.86);
    }

    .lightbox[open] {
      animation: lightboxIn 0.2s var(--ease);
    }

    .lightbox__panel {
      position: relative;
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr) 56px;
      align-items: center;
      gap: 8px;
      padding: 18px;
    }

    .lightbox__figure {
      grid-column: 2;
      display: grid;
      place-items: center;
      min-height: 0;
      max-height: calc(92svh - 110px);
      overflow: hidden;
      border-radius: 10px;
      background: var(--navy);
      touch-action: none;
    }

    .lightbox__figure img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: calc(92svh - 110px);
      object-fit: contain;
    }

    .lightbox__figure img.is-error {
      visibility: hidden;
    }

    .lightbox__close {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.14);
      color: var(--white);
      cursor: pointer;
    }

    .lightbox__close:hover {
      background: rgba(250, 249, 246, 0.24);
    }

    .lightbox__close:focus-visible,
    .lightbox__nav:focus-visible {
      outline: 3px solid var(--white);
      outline-offset: 3px;
    }

    .lightbox__nav {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.12);
      color: var(--white);
      cursor: pointer;
    }

    .lightbox__nav:hover {
      background: rgba(250, 249, 246, 0.22);
    }

    .lightbox__nav--prev {
      grid-column: 1;
    }

    .lightbox__nav--next {
      grid-column: 3;
    }

    .lightbox__nav svg,
    .lightbox__close svg {
      width: 20px;
      height: 20px;
    }

    .lightbox__caption {
      grid-column: 1 / -1;
      margin-top: 12px;
      color: rgba(255, 255, 255, 0.68);
      font-size: 0.8rem;
      text-align: center;
    }

    body.lightbox-open {
      overflow: hidden;
    }

    @keyframes lightboxIn {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .footer {
      padding: 34px 0;
      background: var(--navy);
      color: var(--white);
    }

    .footer__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .footer__brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .footer__mark {
      width: 28px;
      height: 28px;
      flex: none;
      overflow: hidden;
      border-radius: 8px;
    }

    .footer__mark svg {
      width: 100%;
      height: 100%;
    }

    .footer__text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .footer__name {
      font-family: "Fraunces", Georgia, serif;
      font-size: 0.94rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .footer__app {
      margin-top: 3px;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .footer__status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
    }

    .footer__status.is-online {
      border-color: rgba(42, 99, 255, 0.5);
      color: var(--white);
    }

    .footer__status.is-online .status-dot {
      background: #7FA7FF;
      box-shadow: 0 0 0 3px rgba(42, 99, 255, 0.2);
    }

    .footer__status.is-offline .status-dot {
      background: #FFB4A8;
      box-shadow: 0 0 0 3px rgba(255, 180, 168, 0.14);
    }

    @media (max-width: 1100px) {
      .hero__inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 44px;
      }

      .hero__copy {
        max-width: 700px;
      }

      .hero__collage {
        max-width: 620px;
        justify-self: start;
      }

      .section-head {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .section-head__sub {
        justify-self: start;
      }

      .gallery__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 860px) {
      .video-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .hero {
        min-height: auto;
        padding: calc(var(--nav-h) + 36px) 0 64px;
      }

      .hero__title {
        max-width: 11ch;
        font-size: clamp(2.6rem, 12vw, 4.4rem);
      }

      .hero__collage {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        max-width: none;
        padding-top: 10px;
      }

      .hero__card {
        flex: 0 0 40%;
        margin-top: 0;
      }

      .hero__card:nth-child(1) {
        z-index: 1;
        margin: 6% -7% 0 0;
      }

      .hero__card:nth-child(2) {
        z-index: 2;
        margin: 0;
      }

      .hero__card:nth-child(3) {
        z-index: 1;
        margin: 8% 0 0 -7%;
      }

      .hero__card:nth-child(4) {
        display: none;
      }

      .hero__card-frame {
        aspect-ratio: 3 / 4 !important;
      }

      .gallery__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .lightbox__panel {
        grid-template-columns: 1fr;
        padding: 12px;
      }

      .lightbox__figure {
        grid-column: 1;
      }

      .lightbox__nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
      }

      .lightbox__nav--prev {
        left: 14px;
      }

      .lightbox__nav--next {
        right: 14px;
      }
    }

    @media (max-width: 560px) {
      .container {
        width: min(var(--container), calc(100% - 32px));
      }

      .brand__app {
        display: none;
      }

      .nav-links {
        gap: 0;
      }

      .nav-link {
        padding: 0 10px;
        font-size: 0.76rem;
      }

      .hero__actions {
        gap: 10px;
      }

      .btn {
        min-height: 46px;
        padding: 0 18px;
      }

      .menu-grid {
        grid-template-columns: 1fr;
      }

      .menu-group--compact .menu-grid {
        grid-template-columns: 1fr;
      }

      .menu-item__top {
        gap: 12px;
      }

      .video-grid {
        grid-template-columns: 1fr;
      }

      .footer__inner {
        align-items: flex-start;
        flex-direction: column;
        gap: 14px;
      }
    }

    @media (max-width: 380px) {
      .brand__name {
        font-size: 0.96rem;
      }

      .nav-link {
        padding: 0 8px;
        font-size: 0.72rem;
      }

      .hero__card {
        flex-basis: 42%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      .hero__track {
        display: none;
      }

      .hero__slide img,
      .hero__card-frame,
      .hero__card {
        animation: none !important;
      }

      .hero__card {
        opacity: 1;
        transform: none;
      }

      .js .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .js .gallery__item img {
        filter: none;
      }

      .lightbox[open] {
        animation: none;
      }
    }
  </style>
  <noscript>
    <style>
      .reveal { opacity: 1 !important; transform: none !important; }
      .gallery__item img { filter: none !important; }
      .menu-pills__indicator { display: none !important; }
    </style>
  </noscript>
</head>
<body>
  <svg class="icon-sprite" aria-hidden="true" focusable="false">
