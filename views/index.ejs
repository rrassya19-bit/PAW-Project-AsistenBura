    </symbol>
    <symbol id="ikon-susu" viewBox="0 0 24 24">
      <path d="M6 8h12l-1.2 10.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M7 11h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
