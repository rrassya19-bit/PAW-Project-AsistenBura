<%# Halaman beranda: seluruh menu berasal dari database %>
<%- include('partials/head', { judul }) %>
<%- include('partials/navbar', { halaman }) %>
<main id="konten">
  <%# Bagian hero dengan latar hangat dan informasi utama kedai %>
  <section class="relative overflow-hidden border-b border-kremTua">
    <div class="absolute inset-0 bg-gradient-to-br from-krem via-kremTua/70 to-karamel/30" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-24">
      <%# Kolom kiri: judul, deskripsi, dan tombol aksi %>
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-karamel/40 bg-white/60 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-kopi">
          Kedai kopi · Yogyakarta
        </p>
        <h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-tight tracking-tight text-espresso sm:text-5xl lg:text-6xl">
          Kopi yang menemani waktu lambat.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-kopi sm:text-lg">
          <%= tagline %> <%= deskripsi %>
        </p>
        <%# Tombol menuju menu dan pengelolaan produk %>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#menu" class="rounded-full bg-espresso px-5 py-3 text-sm font-semibold text-krem transition hover:bg-kopi focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aksen">
            Lihat menu
          </a>
          <a href="/produk" class="rounded-full border border-espresso/20 bg-white/70 px-5 py-3 text-sm font-semibold text-espresso transition hover:border-espresso/40 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aksen">
            Kelola produk
          </a>
        </div>
        <%# Lencana status server dan database dari controller %>
        <div class="mt-8 flex flex-wrap items-center gap-2 text-xs font-semibold">
          <span class="inline-flex items-center gap-2 rounded-full border border-hijau/30 bg-hijau/10 px-3 py-1 text-hijau">
            <span class="h-2 w-2 rounded-full bg-hijau" aria-hidden="true"></span>
            Server <%= statusServer %>
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 <%= statusDatabase === 'terhubung' ? 'border-hijau/30 bg-hijau/10 text-hijau' : 'border-merah/30 bg-merah/10 text-merah' %>">
            <span class="h-2 w-2 rounded-full <%= statusDatabase === 'terhubung' ? 'bg-hijau' : 'bg-merah' %>" aria-hidden="true"></span>
            Database <%= statusDatabase %>
          </span>
          <span class="rounded-full border border-karamel/30 bg-white/60 px-3 py-1 text-kopi">
            Diperbarui <%= waktuTerformat %>
          </span>
        </div>
      </div>
      <%# Kolom kanan: ringkasan jumlah menu dari database %>
      <aside class="rounded-3xl border border-karamel/30 bg-white/70 p-6 shadow-sm backdrop-blur sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-aksen">Ringkasan menu</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-kremTua/70 p-4">
            <p class="font-display text-4xl font-semibold text-espresso"><%= jumlahProduk %></p>
            <p class="mt-1 text-sm text-kopi">Produk tersimpan</p>
          </div>
          <div class="rounded-2xl bg-kremTua/70 p-4">
            <p class="font-display text-4xl font-semibold text-espresso"><%= jumlahKategori %></p>
            <p class="mt-1 text-sm text-kopi">Kategori menu</p>
          </div>
        </div>
        <p class="mt-5 text-sm leading-relaxed text-kopi">
          Semua data di halaman ini dibaca langsung dari PostgreSQL melalui REST API internal aplikasi.
        </p>
        <a href="/produk/tambah" class="mt-5 inline-flex rounded-full bg-aksen px-4 py-2 text-sm font-semibold text-white transition hover:bg-aksen/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-espresso">
          Tambah produk baru
        </a>
      </aside>
    </div>
  </section>

  <%# Bagian menu yang dikelompokkan per kategori %>
  <section id="menu" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-aksen">Dari database</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-espresso sm:text-4xl">Menu Bura Bura</h2>
      </div>
      <p class="text-sm text-kopi"><%= jumlahProduk %> produk dalam <%= jumlahKategori %> kategori</p>
    </div>

    <%# Keadaan kosong bila database belum berisi produk %>
    <% if (kategoriMenu.length === 0) { %>
      <div class="mt-10 rounded-3xl border border-dashed border-karamel/50 bg-white/60 p-10 text-center">
        <p class="font-display text-xl font-semibold text-espresso">Belum ada menu</p>
        <p class="mt-2 text-sm text-kopi">Tambahkan produk pertama agar daftar menu muncul di sini.</p>
        <a href="/produk/tambah" class="mt-5 inline-flex rounded-full bg-espresso px-4 py-2 text-sm font-semibold text-krem transition hover:bg-kopi focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aksen">
          Tambah produk
        </a>
      </div>
    <% } %>

    <%# Setiap kategori dirender sebagai satu kelompok kartu %>
    <% kategoriMenu.forEach(function (kategori) { %>
      <section class="mt-12">
        <div class="flex items-baseline justify-between gap-4 border-b border-kremTua pb-3">
          <h3 class="font-display text-2xl font-semibold text-espresso"><%= kategori.nama %></h3>
          <span class="text-sm text-kopi"><%= kategori.jumlah %> menu</span>
        </div>
        <%# Grid kartu produk yang responsif %>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% kategori.produk.forEach(function (produk) { %>
            <article class="flex h-full flex-col justify-between rounded-2xl border border-kremTua bg-white/75 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-karamel/50 hover:shadow-md">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <h4 class="font-semibold leading-snug text-espresso"><%= produk.nama %></h4>
                  <%# Tanda habis hanya muncul bila produk tidak tersedia %>
                  <% if (!produk.tersedia) { %>
                    <span class="shrink-0 rounded-full border border-merah/30 bg-merah/10 px-2 py-0.5 text-xs font-semibold text-merah">Habis</span>
                  <% } %>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-kopi">
                  <%= produk.deskripsi ? produk.deskripsi : 'Tanpa deskripsi.' %>
                </p>
              </div>
              <p class="mt-4 text-sm font-semibold text-aksen"><%= formatRentangHarga(produk.harga, produk.hargaMaks) %></p>
            </article>
          <% }); %>
        </div>
      </section>
    <% }); %>

    <%# Ajakan mengelola data produk %>
    <div class="mt-14 flex flex-col items-start justify-between gap-4 rounded-3xl bg-espresso px-6 py-8 text-krem sm:flex-row sm:items-center sm:px-8">
      <div>
        <p class="font-display text-2xl font-semibold">Perlu memperbarui menu?</p>
        <p class="mt-1 text-sm text-krem/75">Tambah, ubah, atau hapus produk langsung dari halaman pengelolaan.</p>
      </div>
      <a href="/produk" class="rounded-full bg-aksen px-5 py-3 text-sm font-semibold text-white transition hover:bg-aksen/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-krem">
        Buka daftar produk
      </a>
    </div>
  </section>
</main>
<%- include('partials/footer', { namaKafe }) %>
