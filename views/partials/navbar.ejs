<%
  // Nama aplikasi dipakai sebagai teks kecil di bawah merek
  const aplikasi = typeof appName !== 'undefined' ? appName : 'Asisten Bura';
  // Halaman beranda memakai tautan jangkar, halaman lain memakai tautan absolut
  const diBeranda = typeof halaman !== 'undefined' && halaman === 'beranda';
  // Awalan tautan bagian beranda disesuaikan dengan halaman aktif
  const awalan = diBeranda ? '' : '/';
%>
<%# Header lama: merek, navigasi utama, dan navigasi seluler %>
<header class="site-header<%= diBeranda ? '' : ' site-header--page' %>" data-header>
  <div class="shell nav-shell">
    <%# Merek menuju awal halaman beranda atau beranda bila di halaman lain %>
    <a class="brand" href="<%= diBeranda ? '#atas' : '/' %>" aria-label="<%= namaKafe %>, kembali ke awal halaman">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="9" fill="#002FA7" />
          <rect x="6" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
          <rect x="18" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
          <circle cx="10" cy="13" r="1.4" fill="#002FA7" />
          <circle cx="10" cy="19" r="1.4" fill="#002FA7" />
          <circle cx="22" cy="13" r="1.4" fill="#002FA7" />
          <circle cx="22" cy="19" r="1.4" fill="#002FA7" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name"><%= namaKafe %></span>
        <span class="brand__app"><%= aplikasi %></span>
      </span>
    </a>

    <%# Navigasi utama berisi tautan bagian beranda %>
    <nav class="primary-nav" aria-label="Navigasi utama">
      <a class="nav-link" href="<%= awalan %>#menu" data-nav>Menu</a>
      <a class="nav-link" href="<%= awalan %>#cerita" data-nav>Cerita</a>
      <a class="nav-link" href="<%= awalan %>#galeri" data-nav>Galeri</a>
      <a class="nav-link" href="<%= awalan %>#gerak" data-nav>Video</a>
      <a class="nav-link" href="<%= awalan %>#mampir" data-nav>Mampir</a>
    </nav>

    <%# Navigasi seluler memakai daftar yang sama %>
    <details class="mobile-nav">
      <summary aria-label="Buka navigasi">Menu</summary>
      <nav aria-label="Navigasi seluler">
        <a href="<%= awalan %>#menu">Menu</a>
        <a href="<%= awalan %>#cerita">Cerita</a>
        <a href="<%= awalan %>#galeri">Galeri</a>
        <a href="<%= awalan %>#gerak">Video</a>
        <a href="<%= awalan %>#mampir">Mampir</a>
      </nav>
    </details>
  </div>
  <%# Bilah kemajuan gulir milik desain lama %>
  <div class="progress" aria-hidden="true"><span class="progress__bar" data-progress></span></div>
</header>