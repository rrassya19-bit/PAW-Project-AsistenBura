<%
  // Tahun berjalan dihitung saat halaman dirender
  const tahunFooter = new Date().getFullYear();
  // Nama aplikasi dan slogan memakai nilai controller dengan cadangan aman
  const aplikasiFooter = typeof appName !== 'undefined' ? appName : 'Asisten Bura';
  const sloganFooter = typeof tagline !== 'undefined' ? tagline : 'Kopi, ruang, dan waktu yang lambat.';
  // Kontak memakai nilai controller; halaman 404 memakai tautan cadangan
  const kontakFooter = typeof kontak !== 'undefined' ? kontak : {
    peta: 'https://www.google.com/maps/search/?api=1&query=Bura+Bura+Coffee+Yogyakarta',
    instagram: 'https://www.instagram.com/explore/tags/buraburacoffee/',
  };
  // Tautan bagian footer menyesuaikan halaman yang sedang dibuka
  const diBerandaFooter = typeof halaman !== 'undefined' && halaman === 'beranda';
  const awalanFooter = diBerandaFooter ? '' : '/';
%>
<%# Footer lama: identitas kedai, direktori tautan, dan status server %>
<footer class="footer">
  <div class="shell footer__main">
    <div>
      <div class="footer__brand">
        <span class="footer__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="9" fill="#002FA7" />
            <rect x="6" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <rect x="18" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <circle cx="10" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="10" cy="19" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="19" r="1.4" fill="#002FA7" />
          </svg>
        </span>
        <span class="footer__text">
          <span class="footer__name"><%= namaKafe %></span>
          <span class="footer__app"><%= aplikasiFooter %></span>
        </span>
      </div>
      <p class="footer__tagline"><%= sloganFooter %></p>
    </div>

    <div class="footer__directory">
      <div class="footer__group">
        <p class="footer__group-title">Jelajahi</p>
        <nav class="footer__links" aria-label="Navigasi footer">
          <a href="<%= awalanFooter %>#menu">Menu</a>
          <a href="<%= awalanFooter %>#cerita">Cerita</a>
          <a href="<%= awalanFooter %>#galeri">Galeri</a>
          <a href="<%= awalanFooter %>#gerak">Video</a>
        </nav>
      </div>
      <div class="footer__group">
        <p class="footer__group-title">Temukan</p>
        <nav class="footer__links" aria-label="Tautan eksternal">
          <a href="<%= kontakFooter.peta %>" target="_blank" rel="noopener noreferrer">Peta</a>
          <a href="<%= kontakFooter.instagram %>" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="<%= awalanFooter %>#mampir">Jam buka</a>
        </nav>
      </div>
    </div>
  </div>

  <div class="shell footer__bottom">
    <span>&copy; <%= tahunFooter %> <%= namaKafe %> · dibuat oleh <%= aplikasiFooter %></span>
    <%# Indikator status diperbarui oleh partial scripts/status.ejs %>
    <p class="footer__status" data-status aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <span data-status-text>Memeriksa...</span>
    </p>
  </div>
</footer>
<%# Skrip halaman dan status dimuat oleh masing-masing template setelah footer %>