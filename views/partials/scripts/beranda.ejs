<%# Skrip beranda dan halaman media, tanpa library %>
<script>// Skrip beranda: animasi gulir, galeri, filter, video, dan detail foto
(function () {
      'use strict';

      // Waktu tampil setiap foto latar hero sebelum berganti
      var JEDA_GANTI_MS = 7000;
      // Durasi crossfade latar hero; harus sama dengan transisi opacity CSS
      var DURASI_FADE_MS = 1500;

      var doc = document;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var header = doc.querySelector('[data-header]');
      var progress = doc.querySelector('[data-progress]');
      var hero = doc.querySelector('[data-hero]');
      var heroMedia = doc.querySelector('[data-hero-media]');
      var navLinks = Array.prototype.slice.call(doc.querySelectorAll('[data-nav]'));
      var revealItems = Array.prototype.slice.call(doc.querySelectorAll('.reveal'));

      function revealAll() {
        revealItems.forEach(function (item) {
          item.classList.add('is-visible');
        });
      }

      if ('IntersectionObserver' in window && !reduceMotion.matches) {
        var revealObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { threshold: 0.01, rootMargin: '0px 0px -6% 0px' });

        revealItems.forEach(function (item) {
          revealObserver.observe(item);
        });
      } else {
        revealAll();
      }

      var ticking = false;

      function updateScroll() {
        ticking = false;

        var y = window.scrollY || window.pageYOffset || 0;

        if (header) {
          header.classList.toggle('is-scrolled', y > 8);
        }

        if (progress) {
          var max = doc.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = 'scaleX(' + (max > 0 ? Math.min(y / max, 1) : 0) + ')';
        }

        if (heroMedia && hero && !reduceMotion.matches) {
          var rect = hero.getBoundingClientRect();
          var p = Math.min(Math.max(-rect.top / Math.max(rect.height, 1), 0), 1);
          heroMedia.style.setProperty('--hero-shift', (p * 26).toFixed(1) + 'px');
        }
      }

      function requestScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateScroll);
      }

      window.addEventListener('scroll', requestScroll, { passive: true });
      window.addEventListener('resize', requestScroll);
      updateScroll();

      /* ---------- Rotasi latar hero ---------- */

      function siapkanRotasiHero() {
        if (!heroMedia) return;

        var teksSlide = heroMedia.getAttribute('data-slides');
        var daftarSlide = [];

        try {
          daftarSlide = JSON.parse(teksSlide || '[]');
        } catch (galat) {
          daftarSlide = [];
        }

        if (!Array.isArray(daftarSlide)) return;

        daftarSlide = daftarSlide.filter(function (src) {
          return typeof src === 'string' && src.length > 0;
        });

        // Kurang dari dua foto berarti tidak ada rotasi
        if (daftarSlide.length < 2) return;

        // Hormati penghematan data dan preferensi gerak minimal
        var koneksi = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var hematData = koneksi && (
          koneksi.saveData === true ||
          koneksi.effectiveType === 'slow-2g' ||
          koneksi.effectiveType === '2g'
        );

        if (reduceMotion.matches || hematData) return;

        var lapisan = Array.prototype.slice.call(heroMedia.querySelectorAll('img'));

        // Rotasi hanya memakai dua lapisan gambar hero
        if (lapisan.length !== 2) return;

        var lapisanAktif = 0;
        var indeksSlide = 0;
        var timer = null;
        var berjalan = true;
        var sedangMemuat = false;
        var heroTerlihat = true;

        // Mengacak daftar dengan algoritme Fisher-Yates
        function acakDaftar(daftar) {
          for (var i = daftar.length - 1; i > 0; i -= 1) {
            var j = Math.floor(Math.random() * (i + 1));
            var sementara = daftar[i];
            daftar[i] = daftar[j];
            daftar[j] = sementara;
          }

          return daftar;
        }

        // Foto pertama tetap, sisanya diacak sekali per halaman
        var urutan = [daftarSlide[0]].concat(acakDaftar(daftarSlide.slice(1)));

        function bersihkanTimer() {
          if (timer !== null) {
            window.clearTimeout(timer);
            timer = null;
          }
        }

        function bisaJalan() {
          return berjalan && !doc.hidden && heroTerlihat && !reduceMotion.matches;
        }

        function jadwalkan(jeda) {
          bersihkanTimer();

          if (!bisaJalan()) return;

          timer = window.setTimeout(function () {
            timer = null;
            gantiSlide((indeksSlide + 1) % urutan.length, urutan.length - 1);
          }, jeda);
        }

        // Memuat satu foto berikutnya sebelum crossfade dimulai
        function muatFoto(url, selesai) {
          var gambar = new Image();
          var sudahSelesai = false;

          function beres(berhasil) {
            if (sudahSelesai) return;
            sudahSelesai = true;
            selesai(berhasil);
          }

          gambar.onload = function () {
            beres(true);
          };

          gambar.onerror = function () {
            beres(false);
          };

          gambar.src = url;

          if (typeof gambar.decode === 'function') {
            gambar.decode().then(function () {
              beres(true);
            }).catch(function () {
              // Kegagalan decode ditangani onerror bila gambar tidak valid
            });
          }
        }

        function gantiSlide(kandidat, sisaPercobaan) {
          if (!bisaJalan() || sedangMemuat) return;

          if (sisaPercobaan < 0) {
            jadwalkan(JEDA_GANTI_MS);
            return;
          }

          sedangMemuat = true;

          muatFoto(urutan[kandidat], function (berhasil) {
            sedangMemuat = false;

            if (!bisaJalan()) return;

            if (!berhasil) {
              // Lewati foto rusak tanpa menunggu lama
              gantiSlide((kandidat + 1) % urutan.length, sisaPercobaan - 1);
              return;
            }

            var lama = lapisan[lapisanAktif];
            var baru = lapisan[1 - lapisanAktif];

            baru.src = urutan[kandidat];
            baru.alt = '';
            baru.classList.remove('hero__foto--awal');
            baru.classList.add('hero__foto--aktif');
            lama.classList.remove('hero__foto--awal');
            lama.classList.remove('hero__foto--aktif');

            lapisanAktif = 1 - lapisanAktif;
            indeksSlide = kandidat;

            jadwalkan(JEDA_GANTI_MS);
          });
        }

        function jedaRotasi() {
          bersihkanTimer();
        }

        function lanjutkanRotasi() {
          if (!bisaJalan()) {
            bersihkanTimer();
            return;
          }

          if (timer === null && !sedangMemuat) {
            jadwalkan(JEDA_GANTI_MS);
          }
        }

        // Aktifkan mode rotasi dan pastikan lapisan pertama mulai dari 1.02
        heroMedia.classList.add('hero__media--rotasi');
        heroMedia.style.setProperty('--durasi-fade-hero', (DURASI_FADE_MS / 1000) + 's');
        heroMedia.style.setProperty('--durasi-zoom-hero', ((JEDA_GANTI_MS + DURASI_FADE_MS) / 1000) + 's');
        lapisan[0].style.transition = 'none';
        void lapisan[0].offsetWidth;
        lapisan[0].style.transition = '';

        // Lapisan pertama diaktifkan setelah frame awal agar zoom terlihat
        window.requestAnimationFrame(function () {
          lapisan[0].classList.remove('hero__foto--awal');
          lapisan[0].classList.add('hero__foto--aktif');
          jadwalkan(JEDA_GANTI_MS);
        });

        // Jeda saat tab tidak aktif
        doc.addEventListener('visibilitychange', function () {
          if (doc.hidden) {
            jedaRotasi();
          } else {
            lanjutkanRotasi();
          }
        });

        // Jeda saat hero keluar dari layar
        if (hero && 'IntersectionObserver' in window) {
          var pengamatHero = new IntersectionObserver(function (entries) {
            heroTerlihat = entries[0] ? entries[0].isIntersecting : true;

            if (heroTerlihat) {
              lanjutkanRotasi();
            } else {
              jedaRotasi();
            }
          }, { threshold: 0.01 });

          pengamatHero.observe(hero);
        }

        // Hentikan rotasi bila preferensi gerak minimal diaktifkan
        if (reduceMotion.addEventListener) {
          reduceMotion.addEventListener('change', function () {
            if (reduceMotion.matches) {
              berjalan = false;
              bersihkanTimer();
            }
          });
        }
      }

      siapkanRotasiHero();

      if ('IntersectionObserver' in window && navLinks.length) {
        // Hanya tautan jangkar pada halaman yang sama yang dijadikan target
        var navSections = navLinks.map(function (link) {
          var tujuan = link.getAttribute('href');
          if (!tujuan || tujuan.charAt(0) !== '#') return null;
          return doc.querySelector(tujuan);
        }).filter(Boolean);

        var navObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            navLinks.forEach(function (link) {
              if (link.getAttribute('href') === '#' + entry.target.id) {
                link.setAttribute('aria-current', 'true');
              } else {
                link.removeAttribute('aria-current');
              }
            });
          });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

        navSections.forEach(function (section) {
          navObserver.observe(section);
        });
      }

      var pillLinks = Array.prototype.slice.call(doc.querySelectorAll('[data-kategori-link]'));

      function setActivePill(link) {
        if (!link) return;

        pillLinks.forEach(function (pill) {
          if (pill === link) {
            pill.setAttribute('aria-current', 'true');
          } else {
            pill.removeAttribute('aria-current');
          }
        });
      }

      if ('IntersectionObserver' in window && pillLinks.length) {
        var pillSections = pillLinks.map(function (pill) {
          return doc.querySelector(pill.getAttribute('href'));
        }).filter(Boolean);

        var pillObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            var link = pillLinks.find(function (pill) {
              return pill.getAttribute('href') === '#' + entry.target.id;
            });

            if (link) setActivePill(link);
          });
        }, { rootMargin: '-28% 0px -62% 0px', threshold: 0 });

        pillSections.forEach(function (section) {
          pillObserver.observe(section);
        });
      }

      pillLinks.forEach(function (pill) {
        pill.addEventListener('click', function () {
          setActivePill(pill);
        });
      });

      /* ---------- Galeri + filter + lightbox ---------- */

      var galleryItems = Array.prototype.slice.call(doc.querySelectorAll('[data-gallery-item]'));
      var filters = Array.prototype.slice.call(doc.querySelectorAll('[data-filter]'));
      var visibleItems = galleryItems.slice();
      var galleryDialog = doc.querySelector('[data-lightbox]');
      var galleryImage = galleryDialog ? galleryDialog.querySelector('[data-lightbox-img]') : null;
      var galleryCaption = galleryDialog ? galleryDialog.querySelector('[data-lightbox-caption]') : null;
      var galleryIndex = 0;
      var galleryTrigger = null;

      function applyFilter(koleksi) {
        galleryItems.forEach(function (item) {
          var cocok = koleksi === 'all' || item.getAttribute('data-koleksi') === koleksi;
          item.hidden = !cocok;
        });

        visibleItems = galleryItems.filter(function (item) {
          return !item.hidden;
        });
      }

      filters.forEach(function (filter) {
        filter.addEventListener('click', function () {
          filters.forEach(function (other) {
            other.classList.toggle('is-active', other === filter);
            other.setAttribute('aria-pressed', other === filter ? 'true' : 'false');
          });

          applyFilter(filter.getAttribute('data-filter'));
        });
      });

      function showGallery(index) {
        if (!visibleItems.length || !galleryImage) return;

        galleryIndex = (index + visibleItems.length) % visibleItems.length;

        var item = visibleItems[galleryIndex];

        galleryImage.src = item.getAttribute('data-src');
        galleryImage.alt = item.getAttribute('data-alt') || '';

        if (galleryCaption) {
          galleryCaption.textContent = item.getAttribute('data-koleksi') + ' · foto ' + (galleryIndex + 1) + ' dari ' + visibleItems.length;
        }
      }

      function openGallery(item) {
        if (!galleryDialog || typeof galleryDialog.showModal !== 'function') return;

        galleryTrigger = item || null;
        galleryIndex = Math.max(visibleItems.indexOf(item), 0);
        showGallery(galleryIndex);
        galleryDialog.showModal();
        doc.body.classList.add('lightbox-open');

        var closeButton = galleryDialog.querySelector('[data-lightbox-close]');
        if (closeButton) closeButton.focus();
      }

      function closeGallery() {
        if (galleryDialog && galleryDialog.open) galleryDialog.close();
      }

      galleryItems.forEach(function (item) {
        item.addEventListener('click', function (event) {
          if (!galleryDialog || typeof galleryDialog.showModal !== 'function') return;

          event.preventDefault();
          openGallery(item);
        });
      });

      if (galleryDialog) {
        var closeButton = galleryDialog.querySelector('[data-lightbox-close]');
        var prevButton = galleryDialog.querySelector('[data-lightbox-prev]');
        var nextButton = galleryDialog.querySelector('[data-lightbox-next]');
        var figure = galleryDialog.querySelector('.lightbox__figure');
        var startX = null;

        if (closeButton) closeButton.addEventListener('click', closeGallery);

        if (prevButton) {
          prevButton.addEventListener('click', function () {
            showGallery(galleryIndex - 1);
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', function () {
            showGallery(galleryIndex + 1);
          });
        }

        galleryDialog.addEventListener('close', function () {
          doc.body.classList.remove('lightbox-open');

          if (galleryTrigger) {
            galleryTrigger.focus();
            galleryTrigger = null;
          }
        });

        galleryDialog.addEventListener('click', function (event) {
          if (event.target === galleryDialog) closeGallery();
        });

        galleryDialog.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            showGallery(galleryIndex - 1);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            showGallery(galleryIndex + 1);
          } else if (event.key === 'Tab') {
            var focusables = Array.prototype.slice.call(galleryDialog.querySelectorAll('button')).filter(function (button) {
              return !button.disabled && button.offsetParent !== null;
            });

            if (!focusables.length) return;

            var first = focusables[0];
            var last = focusables[focusables.length - 1];

            if (event.shiftKey && doc.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && doc.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        if (figure) {
          figure.addEventListener('pointerdown', function (event) {
            startX = event.clientX;
          });

          figure.addEventListener('pointerup', function (event) {
            if (startX === null) return;

            var distance = event.clientX - startX;
            startX = null;

            if (Math.abs(distance) < 40) return;

            showGallery(galleryIndex + (distance < 0 ? 1 : -1));
          });

          figure.addEventListener('pointercancel', function () {
            startX = null;
          });
        }
      }

      /* ---------- Video: autoplay terus, tanpa tombol pause ---------- */

      var videos = Array.prototype.slice.call(doc.querySelectorAll('[data-video]'));

      function putarVideo(video) {
        if (!video || !video.paused) return;

        var promise = video.play();

        if (promise && typeof promise.catch === 'function') {
          promise.catch(function () {});
        }
      }

      function putarSemuaVideo() {
        videos.forEach(function (video) {
          putarVideo(video);
        });
      }

      videos.forEach(function (video) {
        video.addEventListener('canplay', function () {
          putarVideo(video);
        });

        video.addEventListener('error', function () {
          var card = video.closest('[data-video-card]');
          if (card) card.classList.add('is-error');
        });

        var source = video.querySelector('source');

        if (source) {
          source.addEventListener('error', function () {
            var card = video.closest('[data-video-card]');
            if (card) card.classList.add('is-error');
          });
        }

        putarVideo(video);
      });

      // Sebagian browser menahan autoplay sampai ada interaksi pertama.
      doc.addEventListener('pointerdown', putarSemuaVideo, { once: true });
      doc.addEventListener('keydown', putarSemuaVideo, { once: true });

      doc.addEventListener('visibilitychange', function () {
        if (!doc.hidden) putarSemuaVideo();
      });

      if (reduceMotion.addEventListener) {
        reduceMotion.addEventListener('change', function () {
          if (reduceMotion.matches) {
            revealAll();

            if (heroMedia) {
              heroMedia.style.setProperty('--hero-shift', '0px');
            }
          }

          requestScroll();
        });
      }

      updateScroll();
    })();
</script>
