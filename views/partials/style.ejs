<%# Partial style: seluruh CSS desain lama dan kelas CRUD, disalin persis ke partial EJS %>
<style>:root {
      --cobalt: #002FA7;
      --cobalt-bright: #2A63FF;
      --navy: #060E2B;
      --paper: #FAF9F6;
      --white: #FFFFFF;
      --muted: #4A5470;
      --line: #E5E2DA;
      --paper-soft: #F3F1EA;
      --glass: rgba(250, 249, 246, 0.82);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --nav-h: 72px;
      --container: 1360px;
      --gap: clamp(12px, 1.6vw, 20px);
      --shadow: 0 30px 80px -52px rgba(6, 14, 43, 0.5);
      --display: "Outfit", "Segoe UI", system-ui, sans-serif;
      --body: "Plus Jakarta Sans", "Segoe UI", system-ui, sans-serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    html,
    body {
      overflow-x: clip;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: var(--paper);
      color: var(--navy);
      font-family: var(--body);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body,
    h1,
    h2,
    h3,
    h4,
    p,
    figure,
    blockquote,
    dl,
    dd {
      margin: 0;
    }

    ul,
    ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img,
    svg,
    video {
      display: block;
      max-width: 100%;
    }

    button {
      font: inherit;
    }

    [hidden] {
      display: none !important;
    }

    ::selection {
      background: #CFE0FF;
      color: var(--navy);
    }

    :focus-visible {
      outline: 3px solid var(--cobalt-bright);
      outline-offset: 3px;
    }

    section[id] {
      scroll-margin-top: calc(var(--nav-h) + 24px);
    }

    .shell {
      width: min(var(--container), calc(100% - 48px));
      margin-inline: auto;
    }

    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .skip-link {
      position: fixed;
      top: 8px;
      left: 8px;
      z-index: 100;
      padding: 11px 16px;
      border-radius: 6px;
      background: var(--cobalt);
      color: var(--white);
      font-size: 0.84rem;
      font-weight: 700;
      transform: translateY(-160%);
      transition: transform 0.2s var(--ease);
    }

    .skip-link:focus {
      transform: none;
    }

    .kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .kicker::before {
      width: 26px;
      height: 1px;
      background: currentColor;
      content: "";
      opacity: 0.55;
    }

    .js .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
      transition-delay: var(--delay, 0ms);
    }

    .js .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    /* ---------- Header ---------- */

    .site-header {
      position: fixed;
      inset: 0 0 auto;
      z-index: 60;
      color: var(--white);
      transition: background-color 0.3s var(--ease), color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    }

    .site-header.is-scrolled {
      background: var(--glass);
      color: var(--navy);
      box-shadow: 0 18px 40px -36px rgba(6, 14, 43, 0.5);
    }

    @supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
      .site-header.is-scrolled {
        -webkit-backdrop-filter: blur(18px) saturate(1.2);
        backdrop-filter: blur(18px) saturate(1.2);
      }
    }

    .nav-shell {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      height: var(--nav-h);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .brand__mark {
      width: 36px;
      height: 36px;
      flex: none;
      overflow: hidden;
      border-radius: 9px;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
    }

    .brand__mark svg {
      width: 100%;
      height: 100%;
    }

    .brand__text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      line-height: 1.05;
    }

    .brand__name {
      font-family: var(--display);
      font-size: 1.04rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .brand__app {
      margin-top: 3px;
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
      transition: color 0.3s var(--ease);
    }

    .site-header.is-scrolled .brand__app {
      color: var(--muted);
    }

    .primary-nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      transition: color 0.2s, background-color 0.2s;
    }

    .nav-link:hover,
    .nav-link[aria-current="true"] {
      background: rgba(255, 255, 255, 0.1);
      color: var(--white);
    }

    .site-header.is-scrolled .nav-link {
      color: var(--muted);
    }

    .site-header.is-scrolled .nav-link:hover,
    .site-header.is-scrolled .nav-link[aria-current="true"] {
      background: rgba(0, 47, 167, 0.06);
      color: var(--cobalt);
    }

    .mobile-nav {
      display: none;
      position: relative;
    }

    .mobile-nav summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 14px;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav[open] summary {
      background: rgba(255, 255, 255, 0.12);
    }

    .mobile-nav nav {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      display: grid;
      width: min(250px, 82vw);
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--paper);
      color: var(--navy);
      box-shadow: 0 24px 60px -28px rgba(6, 14, 43, 0.55);
    }

    .mobile-nav nav a {
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 0.86rem;
      font-weight: 600;
    }

    .mobile-nav nav a:hover {
      background: rgba(0, 47, 167, 0.06);
      color: var(--cobalt);
    }

    .progress {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 2px;
      background: transparent;
    }

    .progress__bar {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--cobalt-bright);
      transform: scaleX(0);
      transform-origin: 0 50%;
      will-change: transform;
    }

    /* ---------- Hero ---------- */

    .hero {
      position: relative;
      display: flex;
      align-items: flex-end;
      min-height: 100svh;
      padding: calc(var(--nav-h) + clamp(36px, 8vh, 84px)) 0 clamp(36px, 5vw, 64px);
      overflow: hidden;
      isolation: isolate;
      background: var(--navy);
      color: var(--white);
    }

    .hero__media {
      position: absolute;
      inset: -4%;
      z-index: -2;
      overflow: hidden;
      background: var(--navy);
      transform: translate3d(0, calc(var(--hero-shift, 0px) * -1), 0);
    }

    .hero__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 54%;
      filter: saturate(0.85) contrast(1.05) brightness(0.94);
      opacity: 0;
    }

    /* Transisi memudar ke warna dasar sebelum foto berikutnya masuk */
    .hero__media--rotasi img {
      transition: opacity var(--durasi-keluar) cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Lapisan pertama tetap terlihat sebelum rotasi dimulai */
    .hero__foto--awal {
      opacity: 1;
    }

    .hero__media--rotasi .hero__foto--aktif {
      opacity: 1;
    }

    .hero__media--rotasi .hero__foto--keluar {
      opacity: 0;
    }

    .hero__media--rotasi .hero__foto--masuk {
      transition-duration: var(--durasi-masuk);
      opacity: 1;
    }

    .hero__veil {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(circle at 78% 22%, rgba(42, 99, 255, 0.3), transparent 46%),
        linear-gradient(180deg, rgba(6, 14, 43, 0.6) 0%, rgba(6, 14, 43, 0.28) 38%, rgba(6, 14, 43, 0.9) 100%);
    }

    .hero__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: clamp(24px, 4vh, 48px);
    }

    .hero__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .hero__eyebrow {
      color: rgba(255, 255, 255, 0.72);
    }

    .hero__loc {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .hero__loc::before {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #7FA7FF;
      box-shadow: 0 0 0 3px rgba(42, 99, 255, 0.25);
      content: "";
    }

    .hero__title {
      max-width: 14ch;
      font-family: var(--display);
      font-size: clamp(3.1rem, 9.4vw, 8.6rem);
      font-weight: 500;
      line-height: 0.88;
      letter-spacing: -0.055em;
      text-wrap: balance;
    }

    .hero__foot {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: clamp(24px, 4vw, 64px);
      margin-top: auto;
      padding-top: clamp(22px, 3vw, 32px);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .hero__desc {
      max-width: 46ch;
      color: rgba(255, 255, 255, 0.78);
      font-size: clamp(0.95rem, 1.2vw, 1.06rem);
      line-height: 1.7;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 21px;
      border: 0;
      border-radius: 999px;
      font-family: var(--body);
      font-size: 0.83rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: transform 0.2s var(--ease), background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .btn svg {
      width: 17px;
      height: 17px;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn--primary {
      background: var(--cobalt-bright);
      color: var(--white);
      box-shadow: 0 14px 32px -18px rgba(42, 99, 255, 0.9);
    }

    .btn--primary:hover {
      background: var(--white);
      color: var(--cobalt);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(255, 255, 255, 0.04);
      color: var(--white);
    }

    .btn--ghost:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .btn--dark {
      background: var(--navy);
      color: var(--white);
    }

    .btn--dark:hover {
      background: var(--cobalt);
    }

    .btn--outline {
      border: 1px solid var(--line);
      background: transparent;
      color: var(--navy);
    }

    .btn--outline:hover {
      border-color: var(--navy);
    }

    /* ---------- Strip berjalan ---------- */

    .strip {
      position: relative;
      padding: clamp(14px, 2vw, 22px) 0;
      overflow: hidden;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }

    .strip__track {
      display: flex;
      gap: 10px;
      width: max-content;
      animation: stripJalan var(--durasi, 56s) linear infinite;
      will-change: transform;
    }

    .strip:hover .strip__track {
      animation-play-state: paused;
    }

    .strip__item {
      position: relative;
      flex: 0 0 auto;
      width: clamp(150px, 16vw, 230px);
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 10px;
      background: var(--paper-soft);
    }

    .strip__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.92);
      transition: filter 0.4s ease, transform 0.5s var(--ease);
    }

    .strip__item:hover img {
      filter: saturate(1.05);
      transform: scale(1.04);
    }

    @keyframes stripJalan {
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    /* ---------- Bagian umum ---------- */

    .section {
      padding: clamp(76px, 9vw, 128px) 0;
    }

    .section--paper {
      background: var(--paper);
    }

    .section--white {
      border-top: 1px solid var(--line);
      background: var(--white);
    }

    .section-head {
      display: grid;
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
      gap: clamp(24px, 5vw, 80px);
      align-items: start;
      margin-bottom: clamp(38px, 5vw, 68px);
      padding-bottom: clamp(26px, 3vw, 40px);
      border-bottom: 1px solid var(--line);
    }

    .section-head__aside {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .section-head__index {
      color: var(--muted);
      font-family: var(--display);
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.12em;
    }

    .section-head__title {
      max-width: 20ch;
      font-family: var(--display);
      font-size: clamp(2.2rem, 4.6vw, 4.4rem);
      font-weight: 500;
      line-height: 0.98;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }

    .section-head__sub {
      max-width: 48ch;
      margin-top: 18px;
      color: var(--muted);
      font-size: clamp(0.94rem, 1.1vw, 1.02rem);
      line-height: 1.75;
    }

    .section-head__meta {
      margin-top: 22px;
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    /* ---------- Menu ---------- */

    .menu__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
      gap: clamp(28px, 5vw, 72px);
      align-items: start;
    }

    .menu__side {
      position: sticky;
      top: calc(var(--nav-h) + 26px);
    }

    .menu__side-title {
      margin-bottom: 14px;
      color: var(--muted);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .menu-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .menu-nav__item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 12px;
      padding: 11px 12px;
      border-radius: 8px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 600;
      transition: background-color 0.2s, color 0.2s;
    }

    .menu-nav__item:hover {
      background: rgba(0, 47, 167, 0.05);
      color: var(--cobalt);
    }

    .menu-nav__item[aria-current="true"] {
      background: var(--navy);
      color: var(--white);
    }

    .menu-nav__num {
      font-family: var(--display);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      opacity: 0.6;
    }

    .menu-nav__count {
      font-size: 0.66rem;
      font-weight: 700;
      opacity: 0.6;
    }

    .menu__note {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.65;
    }

    .menu-list {
      display: flex;
      flex-direction: column;
      gap: clamp(38px, 5vw, 62px);
    }

    .menu-group {
      scroll-margin-top: calc(var(--nav-h) + 96px);
    }

    .menu-group__head {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding-bottom: 13px;
      border-bottom: 1px solid var(--navy);
    }

    .menu-group__title {
      font-family: var(--display);
      font-size: clamp(1.35rem, 2.3vw, 1.85rem);
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    .menu-group__count {
      margin-left: auto;
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 clamp(26px, 3.4vw, 56px);
    }

    .menu-item {
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }

    .menu-item__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
    }

    .menu-item__name {
      font-family: var(--display);
      font-size: 1.08rem;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .menu-item__price {
      margin-left: auto;
      color: var(--cobalt);
      font-size: 0.86rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .menu-item__desc {
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.6;
    }

    .menu-item--out .menu-item__name {
      color: var(--muted);
    }

    .menu-item__badge {
      display: inline-block;
      margin-top: 8px;
      color: var(--cobalt);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .menu-group--compact .menu-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .menu-group--compact .menu-item {
      padding: 14px 0;
    }

    .menu-group--compact .menu-item__desc {
      display: none;
    }

    /* Kartu menu berfoto memakai rasio tetap agar grid tetap rapi */
    .menu-cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(18px, 2.4vw, 30px);
      margin-top: 22px;
    }

    .menu-card {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Wadah foto menyimpan placeholder di belakang gambar */
    .menu-card__media {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--cobalt), var(--navy));
    }

    /* Inisial produk tampil saat foto kosong atau gagal dimuat */
    .menu-card__placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: var(--white);
      font-family: var(--display);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    .menu-card__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s var(--ease);
    }

    .menu-card__badge {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 1;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(6, 14, 43, 0.78);
      color: var(--white);
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .menu-card__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 6px;
      padding-top: 14px;
    }

    .menu-card__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }

    .menu-card__name {
      font-family: var(--display);
      font-size: 1.05rem;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .menu-card__price {
      margin-left: auto;
      color: var(--cobalt);
      font-size: 0.8rem;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }

    .menu-card__desc {
      color: var(--muted);
      font-size: 0.8rem;
      line-height: 1.55;
    }

    .menu-card--out .menu-card__media {
      filter: grayscale(0.35);
      opacity: 0.6;
    }

    .menu-card--out .menu-card__name,
    .menu-card--out .menu-card__price {
      color: var(--muted);
    }

    @media (hover: hover) {
      .menu-card:hover .menu-card__media img {
        transform: scale(1.045);
      }
    }

    @media (max-width: 720px) {
      .menu-cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .menu-cards {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    /* Pratinjau galeri dan video di beranda */
    .media-preview {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(22px, 4vw, 46px);
      align-items: stretch;
    }

    .media-preview__block {
      display: flex;
      min-width: 0;
      flex-direction: column;
      padding: clamp(18px, 2.5vw, 28px);
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--white);
      box-shadow: var(--shadow);
    }

    .media-preview__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
    }

    .media-preview__title {
      font-family: var(--display);
      font-size: 1.4rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .media-preview__meta {
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-align: right;
      text-transform: uppercase;
    }

    .media-preview__photos {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 16px;
    }

    .media-preview__photo {
      position: relative;
      aspect-ratio: 1;
      margin: 0;
      overflow: hidden;
      border-radius: 8px;
      background: var(--paper-soft);
    }

    .media-preview__photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s var(--ease);
    }

    .media-preview__photo figcaption {
      position: absolute;
      bottom: 8px;
      left: 8px;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(250, 249, 246, 0.92);
      color: var(--navy);
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .media-preview__video {
      position: relative;
      flex: 1;
      min-height: 260px;
      margin-top: 16px;
      overflow: hidden;
      border-radius: 10px;
      background: var(--navy);
    }

    .media-preview__video video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .media-preview__button {
      align-self: flex-start;
      margin-top: 18px;
    }

    @media (hover: hover) {
      .media-preview__photo:hover img {
        transform: scale(1.045);
      }
    }

    @media (max-width: 900px) {
      .media-preview {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .menu-empty {
      padding: 40px 0;
      color: var(--muted);
    }

    /* ---------- Cerita ---------- */

    .story__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(32px, 6vw, 96px);
      align-items: start;
    }

    .story__aside {
      position: sticky;
      top: calc(var(--nav-h) + 26px);
    }

    .story__media {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap);
    }

    .story__media figure {
      overflow: hidden;
      border-radius: 12px;
      background: var(--paper-soft);
    }

    .story__media figure:first-child {
      grid-row: span 2;
    }

    .story__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--ease);
    }

    .story__media figure:first-child img {
      aspect-ratio: 3 / 4;
    }

    .story__media figure:not(:first-child) img {
      aspect-ratio: 4 / 3;
    }

    .story__media figure:hover img {
      transform: scale(1.04);
    }

    .story__caption {
      margin-top: 18px;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.7;
    }

    .principles {
      display: flex;
      flex-direction: column;
    }

    .principle {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr);
      gap: clamp(16px, 2.4vw, 28px);
      padding: clamp(22px, 3vw, 34px) 0;
      border-top: 1px solid var(--line);
    }

    .principle:last-child {
      border-bottom: 1px solid var(--line);
    }

    .principle__num {
      color: var(--cobalt);
      font-family: var(--display);
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.1em;
    }

    .principle__title {
      font-family: var(--display);
      font-size: clamp(1.3rem, 2.1vw, 1.7rem);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.022em;
    }

    .principle__desc {
      max-width: 52ch;
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.75;
    }

    /* ---------- Galeri ---------- */

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: clamp(24px, 3vw, 36px);
    }

    .filter {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 38px;
      padding: 0 15px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .filter span {
      color: inherit;
      font-size: 0.64rem;
      opacity: 0.65;
    }

    .filter:hover {
      border-color: var(--navy);
      color: var(--navy);
    }

    .filter.is-active {
      border-color: var(--navy);
      background: var(--navy);
      color: var(--white);
    }

    .gallery-grid {
      columns: 4;
      column-gap: var(--gap);
    }

    .gallery-item {
      position: relative;
      display: block;
      width: 100%;
      margin-bottom: var(--gap);
      overflow: hidden;
      border-radius: 10px;
      background: var(--paper-soft);
      break-inside: avoid;
    }

    .gallery-item img {
      width: 100%;
      height: auto;
      transition: transform 0.55s var(--ease), filter 0.4s ease;
    }

    .gallery-item::after {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 52%, rgba(6, 14, 43, 0.62));
      content: "";
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .gallery-item__meta {
      position: absolute;
      inset: auto 12px 12px;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.25s ease, transform 0.25s var(--ease);
    }

    .gallery-item__koleksi {
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(250, 249, 246, 0.92);
      color: var(--navy);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .gallery-item__zoom {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.92);
      color: var(--navy);
      font-size: 1.1rem;
      line-height: 1;
    }

    @media (hover: hover) {
      .gallery-item:hover img {
        transform: scale(1.045);
      }

      .gallery-item:hover::after,
      .gallery-item:hover .gallery-item__meta,
      .gallery-item:focus-visible .gallery-item__meta {
        opacity: 1;
      }

      .gallery-item:hover .gallery-item__meta,
      .gallery-item:focus-visible .gallery-item__meta {
        transform: none;
      }
    }

    .gallery-item:focus-visible {
      outline: 3px solid var(--cobalt-bright);
      outline-offset: 3px;
    }

    /* ---------- Video ---------- */

    .video-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: clamp(22px, 3vw, 32px);
    }

    .video-note {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .video-note::before {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cobalt-bright);
      box-shadow: 0 0 0 3px rgba(42, 99, 255, 0.18);
      content: "";
      animation: denyut 2.4s ease-in-out infinite;
    }

    @keyframes denyut {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.35;
      }
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(12px, 2vw, 22px);
    }

    .video-card {
      min-width: 0;
    }

    .video-card__frame {
      position: relative;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border-radius: 12px;
      background: var(--navy);
    }

    .video-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .video-card__badge {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 11px;
      border-radius: 999px;
      background: rgba(6, 14, 43, 0.55);
      color: var(--white);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .video-card__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #7FA7FF;
      box-shadow: 0 0 0 3px rgba(42, 99, 255, 0.22);
    }

    .video-card__caption {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-top: 11px;
      padding-top: 10px;
      border-top: 1px solid var(--line);
    }

    .video-card__koleksi {
      color: var(--navy);
      font-size: 0.76rem;
      font-weight: 700;
    }

    .video-card__num {
      color: var(--muted);
      font-family: var(--display);
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.1em;
    }

    .video-card.is-error .video-card__frame {
      display: grid;
      place-items: center;
    }

    .video-card.is-error .video-card__frame::after {
      padding: 20px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.78rem;
      text-align: center;
      content: "Video tidak tersedia";
    }

    .video-card.is-error video,
    .video-card.is-error .video-card__badge {
      display: none;
    }

    /* ---------- Halaman media ---------- */

    /* Jarak atas halaman mandiri memberi ruang untuk header tetap */
    .page-main {
      padding-top: calc(var(--nav-h) + clamp(42px, 6vw, 78px));
    }

    /* Tautan kembali ke beranda pada halaman galeri dan video */
    .page-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 26px;
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 600;
      transition: color 0.2s;
    }

    .page-back:hover {
      color: var(--cobalt);
    }

    .page-back svg {
      width: 16px;
      height: 16px;
    }

    /* Keadaan kosong untuk halaman media tanpa berkas */
    .page-empty {
      padding: clamp(38px, 6vw, 70px) 24px;
      border: 1px dashed var(--line);
      border-radius: 16px;
      background: var(--white);
      text-align: center;
    }

    .page-empty__title {
      font-family: var(--display);
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      font-weight: 500;
      letter-spacing: -0.025em;
    }

    .page-empty__text {
      max-width: 42ch;
      margin: 12px auto 0;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.7;
    }

    .page-empty .btn {
      margin-top: 22px;
    }

    /* Grid video halaman penuh memakai tiga kolom seperti beranda */
    .video-grid--page {
      margin-top: 4px;
    }

    /* ---------- Kunjungi ---------- */

    .visit {
      position: relative;
      padding: clamp(76px, 9vw, 128px) 0;
      overflow: hidden;
      background: var(--navy);
      color: var(--white);
    }

    .visit::before {
      position: absolute;
      inset: -40% -10% auto auto;
      width: 60vw;
      height: 60vw;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(42, 99, 255, 0.28), transparent 62%);
      content: "";
      pointer-events: none;
    }

    .visit__inner {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(32px, 6vw, 96px);
      align-items: start;
    }

    .visit .kicker {
      color: rgba(255, 255, 255, 0.6);
    }

    .visit__title {
      max-width: 14ch;
      margin-top: 18px;
      font-family: var(--display);
      font-size: clamp(2.4rem, 5.4vw, 5rem);
      font-weight: 500;
      line-height: 0.96;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }

    .visit__desc {
      max-width: 42ch;
      margin-top: 22px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.98rem;
      line-height: 1.75;
    }

    .visit__panel {
      padding: clamp(22px, 3vw, 34px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.04);
    }

    .visit__list {
      display: flex;
      flex-direction: column;
    }

    .visit__row {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .visit__row:first-child {
      padding-top: 0;
    }

    .visit__row dt {
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .visit__row dd {
      color: var(--white);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .visit__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }

    .visit .btn--ghost {
      border-color: rgba(255, 255, 255, 0.3);
    }

    /* ---------- Footer ---------- */

    .footer {
      padding: clamp(48px, 6vw, 72px) 0 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      background: var(--navy);
      color: var(--white);
    }

    .footer__main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(28px, 5vw, 72px);
      padding-bottom: clamp(32px, 4vw, 48px);
    }

    .footer__brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .footer__mark {
      width: 34px;
      height: 34px;
      flex: none;
      overflow: hidden;
      border-radius: 9px;
    }

    .footer__mark svg {
      width: 100%;
      height: 100%;
    }

    .footer__text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .footer__name {
      font-family: var(--display);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .footer__app {
      margin-top: 3px;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .footer__tagline {
      max-width: 32ch;
      margin-top: 18px;
      color: rgba(255, 255, 255, 0.64);
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .footer__directory {
      display: flex;
      justify-content: flex-end;
      gap: clamp(28px, 5vw, 72px);
    }

    .footer__group-title {
      margin-bottom: 14px;
      color: rgba(255, 255, 255, 0.42);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .footer__links {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .footer__links a {
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.85rem;
      transition: color 0.2s;
    }

    .footer__links a:hover {
      color: var(--white);
    }

    .footer__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.72rem;
    }

    /* ---------- Lightbox ---------- */

    .lightbox:not([open]) {
      display: none;
    }

    .lightbox {
      width: min(94vw, 1120px);
      max-width: 1120px;
      max-height: 92svh;
      margin: auto;
      padding: 0;
      border: 0;
      border-radius: 18px;
      background: rgba(6, 14, 43, 0.97);
      color: var(--white);
      box-shadow: 0 30px 90px -30px rgba(0, 0, 0, 0.8);
    }

    .lightbox::backdrop {
      background: rgba(2, 6, 20, 0.86);
    }

    .lightbox[open] {
      animation: lightboxIn 0.2s var(--ease);
    }

    .lightbox__panel {
      position: relative;
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr) 56px;
      align-items: center;
      gap: 8px;
      padding: 18px;
    }

    .lightbox__figure {
      grid-column: 2;
      display: grid;
      place-items: center;
      min-height: 0;
      max-height: calc(92svh - 110px);
      overflow: hidden;
      border-radius: 10px;
      background: var(--navy);
      touch-action: none;
    }

    .lightbox__figure img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: calc(92svh - 110px);
      object-fit: contain;
    }

    .lightbox__close {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.14);
      color: var(--white);
      cursor: pointer;
    }

    .lightbox__close:hover {
      background: rgba(250, 249, 246, 0.24);
    }

    .lightbox__close:focus-visible,
    .lightbox__nav:focus-visible {
      outline: 3px solid var(--white);
      outline-offset: 3px;
    }

    .lightbox__nav {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(250, 249, 246, 0.12);
      color: var(--white);
      cursor: pointer;
    }

    .lightbox__nav:hover {
      background: rgba(250, 249, 246, 0.22);
    }

    .lightbox__nav--prev {
      grid-column: 1;
    }

    .lightbox__nav--next {
      grid-column: 3;
    }

    .lightbox__nav svg,
    .lightbox__close svg {
      width: 20px;
      height: 20px;
    }

    .lightbox__caption {
      grid-column: 1 / -1;
      margin-top: 12px;
      color: rgba(255, 255, 255, 0.68);
      font-size: 0.8rem;
      text-align: center;
    }

    body.lightbox-open {
      overflow: hidden;
    }

    @keyframes lightboxIn {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* ---------- Responsif ---------- */

    @media (max-width: 1100px) {
      .section-head {
        grid-template-columns: minmax(0, 1fr);
        gap: 18px;
      }

      .story__layout {
        grid-template-columns: minmax(0, 1fr);
      }

      .story__aside {
        position: static;
        max-width: 640px;
      }

      .gallery-grid {
        columns: 3;
      }

      .visit__inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 900px) {
      .primary-nav {
        display: none;
      }

      .mobile-nav {
        display: block;
      }

      .menu__layout {
        grid-template-columns: minmax(0, 1fr);
        gap: 28px;
      }

      .menu__side {
        position: static;
      }

      .menu-nav {
        flex-direction: row;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 6px;
        scrollbar-width: none;
      }

      .menu-nav::-webkit-scrollbar {
        display: none;
      }

      .menu-nav__item {
        flex: none;
        border: 1px solid var(--line);
        border-radius: 999px;
      }

      .menu-nav__item[aria-current="true"] {
        border-color: var(--navy);
      }

      .menu__note {
        display: none;
      }

      .video-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .footer__main {
        grid-template-columns: minmax(0, 1fr);
      }

      .footer__directory {
        justify-content: flex-start;
      }
    }

    @media (max-width: 720px) {
      .hero {
        min-height: auto;
        padding: calc(var(--nav-h) + 48px) 0 48px;
      }

      .hero__title {
        font-size: clamp(2.9rem, 13.5vw, 5rem);
      }

      .hero__foot {
        grid-template-columns: minmax(0, 1fr);
        gap: 22px;
      }

      .hero__loc {
        display: none;
      }

      .menu-grid,
      .menu-group--compact .menu-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .gallery-grid {
        columns: 2;
      }

      .story__media {
        max-width: none;
      }

      .lightbox__panel {
        grid-template-columns: 1fr;
        padding: 12px;
      }

      .lightbox__figure {
        grid-column: 1;
      }

      .lightbox__nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
      }

      .lightbox__nav--prev {
        left: 14px;
      }

      .lightbox__nav--next {
        right: 14px;
      }
    }

    @media (max-width: 560px) {
      .shell {
        width: min(var(--container), calc(100% - 32px));
      }

      .brand__app {
        display: none;
      }

      .video-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .visit__row {
        grid-template-columns: minmax(0, 1fr);
        gap: 4px;
      }

      .footer__directory {
        gap: 28px;
      }

      .footer__bottom {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 400px) {
      .brand__name {
        font-size: 0.96rem;
      }

      .gallery-grid {
        columns: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      /* Latar hero diam tanpa zoom atau crossfade */
      .hero__media img {
        transition: none !important;
      }

      .strip__track,
      .video-note::before {
        animation: none !important;
      }

      .js .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .lightbox[open] {
        animation: none;
      }
    }

/* ---------- Kelas khusus halaman admin produk (Week 8) ---------- */

/* Header halaman dalam selalu memakai latar terang agar terbaca di atas kertas */
.site-header--page {
  background: var(--glass);
  color: var(--navy);
  box-shadow: 0 18px 40px -36px rgba(6, 14, 43, 0.5);
}

@supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
  .site-header--page {
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
  }
}

/* ---------- Layout admin dengan sidebar (Week 9) ---------- */

/* Sidebar selebar 264px dan konten mengisi sisa lebar layar */
.admin-layout {
  display: grid;
  grid-template-columns: 264px minmax(0, 1fr);
  min-height: 100vh;
}

/* Tautan lewati tersembunyi sampai menerima fokus papan ketik */
.admin-skip {
  position: absolute;
  top: -80px;
  left: 16px;
  z-index: 100;
  padding: 10px 16px;
  border-radius: 10px;
  background: var(--cobalt);
  color: var(--white);
  font-weight: 600;
  transition: top 0.2s var(--ease);
}

.admin-skip:focus {
  top: 16px;
}

/* Sidebar biru tua tetap menempel saat konten digulir */
.admin-sidebar {
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
  height: 100vh;
  padding: 20px 16px;
  overflow-y: auto;
  background: var(--navy);
  color: rgba(255, 255, 255, 0.72);
}

.admin-sidebar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.admin-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  color: var(--white);
  font-family: var(--display);
}

.admin-brand__mark {
  width: 38px;
  height: 38px;
  flex: none;
  overflow: hidden;
  border-radius: 10px;
}

.admin-brand__mark svg {
  display: block;
  width: 100%;
  height: 100%;
}

.admin-brand__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  line-height: 1.2;
}

.admin-brand__name {
  font-size: 0.98rem;
  font-weight: 600;
}

.admin-brand__app {
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

/* Tombol tutup laci hanya ditampilkan pada layar kecil */
.admin-sidebar__tutup {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 10px;
  background: transparent;
  color: var(--white);
  cursor: pointer;
}

.admin-sidebar__tutup svg {
  width: 20px;
  height: 20px;
}

.admin-menu {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-menu__label {
  margin: 0 0 6px;
  padding: 0 12px;
  color: rgba(255, 255, 255, 0.42);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.admin-menu__link {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 12px;
  border-radius: 10px;
  color: rgba(255, 255, 255, 0.74);
  font-size: 0.9rem;
  font-weight: 600;
  transition: background-color 0.2s, color 0.2s;
}

.admin-menu__link svg {
  width: 19px;
  height: 19px;
  flex: none;
}

.admin-menu__link:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
}

.admin-menu__link[aria-current="page"] {
  background: var(--cobalt-bright);
  color: var(--white);
}

.admin-menu__link:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 2px;
}

/* Kaki sidebar mendorong tautan situs dan tombol keluar ke bawah */
.admin-sidebar__foot {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.admin-sidebar__foot form {
  margin: 0;
}

.admin-keluar {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 10px;
  background: transparent;
  color: var(--white);
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s, border-color 0.2s;
}

.admin-keluar svg {
  width: 19px;
  height: 19px;
  flex: none;
}

.admin-keluar:hover {
  border-color: rgba(255, 255, 255, 0.32);
  background: rgba(255, 255, 255, 0.1);
}

.admin-keluar:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 2px;
}

.admin-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Bilah atas setinggi 56px tetap terlihat saat halaman digulir */
.admin-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 12px;
  height: 56px;
  padding: 0 clamp(16px, 3vw, 28px);
  border-bottom: 1px solid var(--line);
  background: rgba(250, 249, 246, 0.94);
}

@supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
  .admin-topbar {
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    background: rgba(250, 249, 246, 0.8);
  }
}

.admin-topbar__toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--white);
  color: var(--navy);
  cursor: pointer;
}

.admin-topbar__toggle svg {
  width: 20px;
  height: 20px;
}

.admin-topbar__judul {
  margin: 0;
  color: var(--muted);
  font-family: var(--body);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.admin-topbar__badge {
  margin-left: auto;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(0, 47, 167, 0.1);
  color: var(--cobalt);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.admin-konten {
  width: 100%;
  max-width: 1180px;
  padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 44px) 88px;
}

.admin-konten:focus {
  outline: none;
}

/* Lapisan gelap hanya aktif saat laci terbuka pada layar kecil */
.admin-scrim {
  display: none;
}

@media (max-width: 960px) {
  .admin-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Sidebar berubah menjadi laci selebar 280px yang meluncur dari kiri */
  .admin-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 60;
    width: 280px;
    max-width: 86vw;
    height: 100vh;
    transform: translateX(-100%);
    transition: transform 0.28s var(--ease);
    box-shadow: 0 30px 80px -40px rgba(6, 14, 43, 0.7);
  }

  .admin-layout--terbuka .admin-sidebar {
    transform: none;
  }

  .admin-sidebar__tutup {
    display: inline-flex;
  }

  .admin-topbar__toggle {
    display: inline-flex;
  }

  .admin-scrim {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: block;
    background: rgba(6, 14, 43, 0.5);
  }

  .admin-scrim[hidden] {
    display: none;
  }

  /* Gulir halaman dikunci selama laci terbuka */
  .admin-laci-terbuka {
    overflow: hidden;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-sidebar,
  .admin-skip {
    transition: none;
  }
}

/* Halaman login admin: kartu di tengah dengan latar kertas situs */
.auth-page {
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: clamp(20px, 5vw, 48px) 20px;
  background:
    radial-gradient(circle at 50% 0%, rgba(0, 47, 167, 0.08), transparent 55%),
    var(--paper);
}

.auth-card {
  width: min(420px, 100%);
  padding: clamp(24px, 4vw, 40px);
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--white);
  box-shadow: var(--shadow);
}

/* Merek pada kartu login */
.auth-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--display);
  font-weight: 600;
}

.auth-brand__mark {
  width: 40px;
  height: 40px;
  flex: none;
  overflow: hidden;
  border-radius: 10px;
}

.auth-brand__mark svg {
  width: 100%;
  height: 100%;
}

.auth-brand__name {
  font-size: 1.05rem;
  letter-spacing: -0.01em;
}

.auth-title {
  margin-top: 24px;
  font-family: var(--display);
  font-size: clamp(1.8rem, 5vw, 2.3rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.04em;
}

.auth-form {
  display: grid;
  gap: 18px;
  margin-top: 26px;
}

/* Kolom sandi dengan tombol tampilkan di dalam bidang */
.auth-password {
  position: relative;
}

.auth-password .crud-input {
  padding-right: 112px;
}

.auth-toggle {
  position: absolute;
  top: 50%;
  right: 6px;
  padding: 8px 10px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--cobalt);
  font-family: var(--body);
  font-size: 0.72rem;
  font-weight: 700;
  cursor: pointer;
  transform: translateY(-50%);
}

.auth-toggle:hover {
  background: rgba(0, 47, 167, 0.06);
}

.auth-toggle:focus-visible {
  outline: 2px solid var(--cobalt-bright);
  outline-offset: 1px;
}

.auth-submit {
  width: 100%;
  margin-top: 4px;
}

.auth-submit:disabled {
  cursor: progress;
  opacity: 0.7;
  transform: none;
}

/* Kotak galat dan catatan keluar pada kartu login */
.auth-alert {
  margin-top: 20px;
  padding: 12px 14px;
  border: 1px solid rgba(163, 58, 42, 0.3);
  border-radius: 10px;
  background: rgba(163, 58, 42, 0.06);
  color: #A33A2A;
  font-size: 0.84rem;
  font-weight: 600;
}

.auth-note {
  margin-top: 20px;
  color: var(--muted);
  font-size: 0.84rem;
}

.auth-back {
  display: inline-block;
  margin-top: 24px;
  color: var(--muted);
  font-size: 0.78rem;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.auth-back:hover {
  color: var(--cobalt);
}

/* Kartu pembungkus tabel dan form admin */
.crud-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--white);
  box-shadow: var(--shadow);
}

/* Tabel daftar produk memakai tipografi dan garis yang sama dengan beranda */
.crud-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.86rem;
}

.crud-table thead {
  background: var(--paper-soft);
}

.crud-table th {
  padding: 14px 18px;
  color: var(--muted);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}

.crud-table td {
  padding: 16px 18px;
  border-top: 1px solid var(--line);
  vertical-align: top;
}

.crud-table tbody tr {
  transition: background-color 0.2s var(--ease);
}

.crud-table tbody tr:hover {
  background: var(--paper);
}

/* Nama produk pada tabel memakai font display seperti judul menu */
.crud-name {
  font-family: var(--display);
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

/* Teks pendukung berwarna redup */
.crud-muted {
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.6;
}

/* Harga menonjol dengan warna cobalt seperti di beranda */
.crud-price {
  color: var(--cobalt);
  font-weight: 700;
  white-space: nowrap;
}

/* Pratinjau foto pada form admin memakai rasio kartu menu */
.crud-foto-preview {
  display: block;
  width: min(100%, 320px);
  aspect-ratio: 4 / 3;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--paper-soft);
  object-fit: cover;
}

/* Gambar mini produk pada daftar admin */
.crud-thumb {
  position: relative;
  display: grid;
  place-items: center;
  flex: none;
  width: 54px;
  height: 54px;
  overflow: hidden;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--cobalt), var(--navy));
  color: var(--white);
}

/* Inisial menjadi placeholder ketika foto belum ada atau gagal dimuat */
.crud-thumb__placeholder {
  font-family: var(--display);
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* Foto menutupi placeholder setelah berhasil dimuat */
.crud-thumb img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Ukuran gambar mini pada kartu produk di layar kecil */
.crud-thumb--small {
  width: 44px;
  height: 44px;
}

/* Lencana status ketersediaan produk */
.crud-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.crud-badge--online {
  border: 1px solid rgba(0, 47, 167, 0.2);
  background: rgba(0, 47, 167, 0.06);
  color: var(--cobalt);
}

.crud-badge--offline {
  border: 1px solid rgba(74, 84, 112, 0.24);
  background: var(--paper-soft);
  color: var(--muted);
}

/* Tombol kecil untuk aksi per baris */
.crud-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: transparent;
  color: var(--navy);
  font-family: var(--body);
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s var(--ease);
}

.crud-btn:hover {
  border-color: var(--navy);
  transform: translateY(-1px);
}

.crud-btn--danger {
  border-color: rgba(163, 58, 42, 0.3);
  color: #A33A2A;
}

.crud-btn--danger:hover {
  border-color: #A33A2A;
  background: rgba(163, 58, 42, 0.06);
}

.crud-btn:disabled {
  cursor: not-allowed;
  opacity: 0.6;
  transform: none;
}

/* Kotak pesan sukses dan gagal dari API */
.crud-alert {
  margin-top: 24px;
  padding: 14px 18px;
  border: 1px solid var(--line);
  border-radius: 10px;
  font-size: 0.85rem;
  font-weight: 600;
}

.crud-alert--sukses {
  border-color: rgba(0, 47, 167, 0.24);
  background: rgba(0, 47, 167, 0.06);
  color: var(--cobalt);
}

.crud-alert--galat {
  border-color: rgba(163, 58, 42, 0.3);
  background: rgba(163, 58, 42, 0.06);
  color: #A33A2A;
}

/* Keadaan kosong saat tabel belum berisi produk */
.crud-empty {
  padding: clamp(40px, 6vw, 72px) 24px;
  border: 1px dashed var(--line);
  border-radius: 14px;
  background: var(--paper);
  text-align: center;
}

/* Label dan input form dengan bahasa visual yang sama */
.crud-label {
  display: block;
  margin-bottom: 8px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.crud-input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--paper);
  color: var(--navy);
  font-family: var(--body);
  font-size: 0.9rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.crud-input::placeholder {
  color: var(--muted);
}

.crud-input:focus {
  border-color: var(--cobalt-bright);
  outline: none;
  box-shadow: 0 0 0 3px rgba(42, 99, 255, 0.14);
}

.crud-check {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--paper);
}

.crud-check input {
  width: 16px;
  height: 16px;
  margin-top: 2px;
  accent-color: var(--cobalt);
}

/* Kartu produk untuk layar kecil */
.crud-card-item {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--white);
  box-shadow: 0 18px 40px -36px rgba(6, 14, 43, 0.5);
}

/* Pratinjau media disembunyikan saat kelas hidden atau atribut hidden aktif */
.crud-foto-preview.hidden,
.crud-foto-preview[hidden] {
  display: none;
}

/* Chatbot publik: launcher bulat, panel percakapan, dan composer */
.chat {
  position: fixed;
  right: 20px;
  bottom: calc(20px + env(safe-area-inset-bottom));
  z-index: 70;
  font-family: var(--body);
}

/* Tombol pembuka tanpa teks, ikon berganti saat panel terbuka */
.chat__toggle {
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--cobalt);
  color: var(--white);
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(6, 14, 43, 0.28);
  transition: transform 0.2s var(--ease), background 0.2s var(--ease);
}

.chat__toggle:hover {
  transform: scale(1.05);
}

.chat__toggle:focus-visible {
  outline: 3px solid var(--cobalt-bright);
  outline-offset: 3px;
}

.chat__toggle svg {
  display: block;
  width: 24px;
  height: 24px;
}

.chat__toggle svg[hidden] {
  display: none;
}

/* Panel desktop dengan animasi lembut dan tinggi terbatas viewport */
.chat__panel {
  position: absolute;
  right: 0;
  bottom: calc(100% + 14px);
  display: flex;
  flex-direction: column;
  width: 384px;
  height: min(620px, calc(100dvh - 104px));
  overflow: hidden;
  border: 1px solid rgba(6, 14, 43, 0.08);
  border-radius: 20px;
  background: var(--white);
  box-shadow: 0 24px 60px rgba(6, 14, 43, 0.28);
  opacity: 0;
  transform: translateY(8px) scale(0.98);
  transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
}

.chat__panel--buka {
  opacity: 1;
  transform: none;
}

/* Header navy dengan avatar logo dan tombol tutup polos */
.chat__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 64px;
  padding: 0 12px 0 16px;
  background: var(--navy);
  color: var(--white);
}

.chat__identitas {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.chat__avatar {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: var(--cobalt);
}

.chat__avatar svg {
  display: block;
  width: 100%;
  height: 100%;
}

.chat__avatar--pesan {
  width: 28px;
  height: 28px;
  background: transparent;
}

.chat__title {
  font-family: var(--body);
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
  color: var(--white);
}

.chat__close {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--white);
  cursor: pointer;
  transition: background 0.18s var(--ease);
}

.chat__close:hover {
  background: rgba(255, 255, 255, 0.12);
}

.chat__close:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 2px;
}

.chat__close svg {
  width: 18px;
  height: 18px;
}

/* Area pesan berlatar abu kebiruan dengan scrollbar tipis */
.chat__log {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12px;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 16px;
  background: #F4F6FB;
  scrollbar-width: thin;
  scrollbar-color: rgba(6, 14, 43, 0.18) transparent;
  scroll-behavior: smooth;
}

.chat__log::-webkit-scrollbar {
  width: 6px;
}

.chat__log::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: rgba(6, 14, 43, 0.18);
}

/* Baris pesan: avatar hanya tampil pada gelembung pertama satu kelompok */
.chat__baris {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  width: 100%;
}

.chat__baris--user {
  justify-content: flex-end;
}

.chat__baris--bot {
  justify-content: flex-start;
}

.chat__baris--lanjut .chat__avatar {
  visibility: hidden;
}

.chat__msg {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 14.5px;
  line-height: 1.55;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.chat__msg--bot {
  border: 1px solid rgba(6, 14, 43, 0.06);
  border-bottom-left-radius: 4px;
  background: var(--white);
  color: var(--navy);
}

.chat__msg--user {
  border-bottom-right-radius: 4px;
  background: var(--cobalt);
  color: var(--white);
}

.chat__msg--galat {
  border: 1px solid #E7C7C2;
  border-bottom-left-radius: 4px;
  background: #FDF3F1;
  color: #8A2C1D;
}

.chat__galat-aksi {
  display: block;
  margin-top: 6px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  text-decoration: underline;
  cursor: pointer;
}

.chat__galat-aksi:focus-visible {
  outline: 2px solid var(--cobalt-bright);
  outline-offset: 2px;
}

/* Indikator mengetik dengan tiga titik yang bergantian naik */
.chat__msg--typing {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 13px 15px;
}

.chat__msg--typing span {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--muted);
  animation: chat-mengetik 1s infinite ease-in-out;
}

.chat__msg--typing span:nth-child(2) {
  animation-delay: 0.15s;
}

.chat__msg--typing span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes chat-mengetik {
  0%,
  70%,
  100% {
    opacity: 0.3;
    transform: translateY(0);
  }

  35% {
    opacity: 1;
    transform: translateY(-3px);
  }
}

/* Chips pertanyaan contoh di bawah sapaan pembuka */
.chat__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-left: 36px;
}

.chat__chip {
  padding: 8px 12px;
  border: 1px solid rgba(0, 47, 167, 0.25);
  border-radius: 999px;
  background: transparent;
  color: var(--cobalt);
  font: inherit;
  font-size: 13px;
  line-height: 1.3;
  cursor: pointer;
  transition: background 0.2s var(--ease);
}

.chat__chip:hover {
  background: rgba(0, 47, 167, 0.08);
}

.chat__chip:focus-visible {
  outline: 2px solid var(--cobalt-bright);
  outline-offset: 2px;
}

/* Composer menyatu tanpa border ganda dan tanpa catatan tambahan */
.chat__form {
  padding: 12px;
  border-top: 1px solid rgba(6, 14, 43, 0.08);
  background: var(--white);
}

.chat__composer {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  padding: 6px 6px 6px 16px;
  border-radius: 22px;
  background: #F1F3F9;
  transition: box-shadow 0.18s var(--ease);
}

.chat__composer:focus-within {
  box-shadow: 0 0 0 2px rgba(0, 47, 167, 0.35);
}

.chat__input {
  flex: 1;
  min-height: 24px;
  max-height: 120px;
  padding: 8px 0;
  overflow-y: hidden;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--navy);
  font: inherit;
  font-size: 15px;
  line-height: 1.5;
  resize: none;
}

.chat__input::placeholder {
  color: var(--muted);
}

.chat__input:disabled {
  opacity: 0.65;
  cursor: default;
}

.chat__send {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  flex: none;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--cobalt);
  color: var(--white);
  cursor: pointer;
  transition: background 0.18s var(--ease), opacity 0.18s var(--ease);
}

.chat__send:hover:not(:disabled) {
  background: var(--cobalt-bright);
}

.chat__send:disabled {
  background: #C3C9D8;
  color: var(--white);
  cursor: default;
}

.chat__send:focus-visible {
  outline: 2px solid var(--cobalt-bright);
  outline-offset: 2px;
}

.chat__send svg {
  width: 18px;
  height: 18px;
}

/* Lightbox galeri memakai top layer dialog, widget disembunyikan saat terbuka */
body.lightbox-open .chat {
  visibility: hidden;
}

/* Mobile: panel menjadi lembar penuh layar dengan safe area */
@media (max-width: 520px) {
  .chat {
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
  }

  .chat__toggle {
    width: 52px;
    height: 52px;
  }

  /* Launcher disembunyikan saat lembar penuh layar terbuka */
  .chat__toggle--aktif {
    display: none;
  }

  .chat__panel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-height: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .chat__head {
    min-height: calc(64px + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
  }

  .chat__form {
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
  }

  .chat__input {
    font-size: 16px;
  }

  html.chat-terbuka,
  body.chat-terbuka {
    overflow: hidden;
  }
}

/* Hormati preferensi pengguna yang mengurangi gerakan */
@media (prefers-reduced-motion: reduce) {
  .chat__panel {
    transition: none;
  }

  .chat__toggle,
  .chat__send,
  .chat__close,
  .chat__chip {
    transition: none;
  }

  .chat__msg--typing span {
    animation: none;
    opacity: 0.6;
  }

  .chat__log {
    scroll-behavior: auto;
  }
}

/* Saran caption AI pada form media admin */
.caption-saran__wadah {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 14px;
}

.caption-saran__info {
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.5;
}

.caption-saran__info--galat {
  color: #8A2C1D;
}

.caption-saran__pilihan {
  padding: 11px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--white);
  color: var(--navy);
  font: inherit;
  font-size: 0.86rem;
  line-height: 1.5;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.caption-saran__pilihan:hover {
  border-color: var(--cobalt-bright);
  background: var(--paper-soft);
}

.caption-saran__pilihan--aktif {
  border-color: var(--cobalt);
  background: #EEF3FF;
}

/* Caption media pada kartu video */
.video-card__ket {
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.5;
}

/* Chat AI caption admin */
.admin-konten--caption {
  max-width: none;
  height: calc(100vh - 56px);
  height: calc(100dvh - 56px);
  padding: 0;
  overflow: hidden;
}

.caption-chat {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--paper);
}

.caption-chat__bar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px clamp(16px, 3vw, 24px);
  border-bottom: 1px solid var(--line);
  background: rgba(250, 249, 246, 0.92);
}

.caption-chat__judul {
  margin: 0;
  color: var(--navy);
  font-family: var(--body);
  font-size: 0.94rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.caption-chat__reset {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 36px;
  padding: 7px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--white);
  color: var(--navy);
  font: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.caption-chat__reset:hover {
  border-color: var(--cobalt-bright);
  background: var(--paper-soft);
}

.caption-chat__reset svg {
  width: 16px;
  height: 16px;
}

.caption-chat__log {
  flex: 1 1 auto;
  min-height: 0;
  padding: 20px clamp(16px, 3vw, 24px) 8px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scroll-behavior: smooth;
}

.caption-chat__baris {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 100%;
  max-width: 760px;
  margin: 0 auto 14px;
}

.caption-chat__baris--pengguna {
  justify-content: flex-end;
}

.caption-chat__avatar {
  display: grid;
  flex: 0 0 28px;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: var(--cobalt);
  color: var(--white);
  font-size: 0.72rem;
  font-weight: 700;
}

.caption-chat__balon {
  max-width: min(100%, 620px);
  padding: 11px 14px;
  border: 1px solid var(--line);
  border-radius: 4px 16px 16px 16px;
  background: var(--white);
  color: var(--navy);
  font-size: 0.89rem;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.caption-chat__balon p {
  margin: 0;
}

.caption-chat__balon--pengguna {
  border: 0;
  border-radius: 16px 4px 16px 16px;
  background: var(--cobalt);
  color: var(--white);
}

.caption-chat__balon--galat {
  border-color: #E2B8AF;
  background: #FFF8F5;
  color: #7E2418;
}

.caption-chat__gambar-pesan {
  display: block;
  width: auto;
  max-width: 240px;
  max-height: 180px;
  margin-bottom: 8px;
  border-radius: 10px;
  object-fit: cover;
}

.caption-chat__chip-grup,
.caption-chat__aksi {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.caption-chat__chip,
.caption-chat__aksi button {
  min-height: 34px;
  padding: 6px 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper-soft);
  color: var(--navy);
  font: inherit;
  font-size: 0.76rem;
  line-height: 1.35;
  cursor: pointer;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.caption-chat__chip:hover,
.caption-chat__aksi button:hover {
  border-color: var(--cobalt-bright);
  background: #EEF3FF;
}

.caption-chat__catatan {
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.55;
}
.caption-chat__detail {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}

.caption-chat__detail summary {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
  list-style: none;
}

.caption-chat__detail summary::-webkit-details-marker {
  display: none;
}

.caption-chat__detail summary::before {
  width: 0;
  height: 0;
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
  border-left: 5px solid currentColor;
  content: "";
  transition: transform 0.16s ease;
}

.caption-chat__detail[open] summary::before {
  transform: rotate(90deg);
}

.caption-chat__pil-grup {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.caption-chat__pil {
  padding: 3px 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper-soft);
  color: var(--navy);
  font-size: 0.72rem;
  line-height: 1.45;
}

.caption-chat__tidak-jelas {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.5;
}

.caption-chat__kartu {
  margin-top: 10px;
  padding: 11px 12px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--paper-soft);
}

.caption-chat__kartu-atas,
.caption-chat__kartu-bawah {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.caption-chat__kartu-label {
  color: var(--muted);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.caption-chat__kartu-teks {
  margin: 7px 0 9px;
  color: var(--navy);
  font-size: 0.89rem;
  line-height: 1.6;
  white-space: pre-wrap;
  user-select: text;
}

.caption-chat__kartu-hitung {
  color: var(--muted);
  font-size: 0.69rem;
}

.caption-chat__salin {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 32px;
  padding: 5px 10px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--white);
  color: var(--navy);
  font: inherit;
  font-size: 0.73rem;
  font-weight: 600;
  cursor: pointer;
}

.caption-chat__salin:hover {
  border-color: var(--cobalt-bright);
}

.caption-chat__salin svg {
  width: 14px;
  height: 14px;
}

.caption-chat__salin--aktif {
  border-color: #9BC7AA;
  background: #EAF6EF;
  color: #1D6538;
}

.caption-chat__aksi {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}

.caption-chat__mengetik {
  display: flex;
  gap: 4px;
  padding: 5px 1px;
}

.caption-chat__mengetik span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--muted);
  animation: caption-chat-detik 1s ease-in-out infinite;
}

.caption-chat__mengetik span:nth-child(2) {
  animation-delay: 0.15s;
}

.caption-chat__mengetik span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes caption-chat-detik {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

.caption-chat__form {
  flex: 0 0 auto;
  padding: 8px clamp(16px, 3vw, 24px) max(12px, env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(250, 249, 246, 0), var(--paper) 22%);
}

.caption-chat__form-isi {
  max-width: 760px;
  margin: 0 auto;
}

.caption-chat__lampiran {
  margin-bottom: 8px;
}

.caption-chat__lampiran-kartu {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  padding: 5px 6px 5px 5px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--white);
}

.caption-chat__lampiran-gambar {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  object-fit: cover;
}

.caption-chat__lampiran-nama {
  max-width: 220px;
  overflow: hidden;
  color: var(--navy);
  font-size: 0.76rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.caption-chat__lampiran-hapus {
  display: grid;
  flex: 0 0 28px;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}

.caption-chat__lampiran-hapus:hover {
  background: var(--paper-soft);
  color: var(--navy);
}

.caption-chat__lampiran-hapus svg {
  width: 16px;
  height: 16px;
}

.caption-chat__kotak {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  padding: 7px 8px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 8px 22px rgba(9, 20, 48, 0.06);
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.caption-chat__kotak:focus-within {
  border-color: var(--cobalt-bright);
  box-shadow: 0 0 0 3px rgba(0, 47, 167, 0.1);
}

.caption-chat__ikon,
.caption-chat__kirim {
  display: grid;
  flex: 0 0 36px;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
}

.caption-chat__ikon {
  border: 0;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}

.caption-chat__ikon:hover {
  background: var(--paper-soft);
  color: var(--cobalt);
}

.caption-chat__ikon svg,
.caption-chat__kirim svg {
  width: 18px;
  height: 18px;
}

.caption-chat__input {
  flex: 1 1 auto;
  min-width: 0;
  max-height: 120px;
  padding: 8px 2px;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--navy);
  font: inherit;
  font-size: 0.92rem;
  line-height: 1.5;
  resize: none;
}

.caption-chat__kirim {
  border: 0;
  background: var(--cobalt);
  color: var(--white);
  cursor: pointer;
}

.caption-chat__kirim:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.caption-chat__galat {
  margin: 8px 4px 0;
  color: #8A2C1D;
  font-size: 0.78rem;
  line-height: 1.45;
}

.caption-chat__drop {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(9, 20, 48, 0.46);
  pointer-events: none;
}

.caption-chat__drop[hidden] {
  display: none;
}

.caption-chat__drop-kartu {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: min(100%, 360px);
  padding: 28px 24px;
  border: 2px dashed rgba(255, 255, 255, 0.8);
  border-radius: 22px;
  background: rgba(9, 20, 48, 0.82);
  color: var(--white);
  text-align: center;
}

.caption-chat__drop-kartu svg {
  width: 32px;
  height: 32px;
}

.caption-chat__drop-kartu p {
  margin: 0;
  font-size: 0.92rem;
  font-weight: 600;
}

@media (max-width: 640px) {
  .caption-chat__bar {
    padding: 8px 12px;
  }

  .caption-chat__reset {
    padding: 6px 10px;
    font-size: 0.72rem;
  }

  .caption-chat__log {
    padding: 16px 12px 6px;
  }

  .caption-chat__balon {
    max-width: calc(100% - 38px);
  }

  .caption-chat__baris--pengguna .caption-chat__balon {
    max-width: 88%;
  }

  .caption-chat__form {
    padding: 6px 12px max(10px, env(safe-area-inset-bottom));
