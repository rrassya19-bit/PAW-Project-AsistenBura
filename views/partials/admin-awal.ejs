<%
  // Tab aktif menentukan penanda navigasi dan judul bilah atas
  const tabAdminAwal = typeof tabAktif !== 'undefined' ? tabAktif : 'produk';
  // Label singkat dipakai pada bilah atas agar konteks halaman selalu terlihat
  const labelTab =
    tabAdminAwal === 'foto'
      ? 'Galeri Foto'
      : tabAdminAwal === 'video'
        ? 'Video'
        : tabAdminAwal === 'caption'
          ? 'AI Caption'
          : 'Menu Utama';
%>
<%- include('head', { judul }) %>
<%# Tautan lewati memudahkan pengguna papan ketik menuju konten %>
<a class="admin-skip" href="#konten">Lewati ke konten utama</a>
<div class="admin-layout" data-admin-layout>
  <%# Sidebar tetap setinggi layar pada desktop dan menjadi laci pada seluler %>
  <aside class="admin-sidebar" id="admin-sidebar" data-admin-sidebar aria-label="Navigasi admin">
    <div class="admin-sidebar__head">
      <a class="admin-brand" href="/admin" aria-label="<%= namaKafe %>, kembali ke daftar menu admin">
        <span class="admin-brand__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="9" fill="#002FA7" />
            <rect x="6" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <rect x="18" y="9" width="8" height="14" rx="2" fill="#FFFFFF" />
            <circle cx="10" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="10" cy="19" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="13" r="1.4" fill="#002FA7" />
            <circle cx="22" cy="19" r="1.4" fill="#002FA7" />
          </svg>
        </span>
        <span class="admin-brand__text">
          <span class="admin-brand__name"><%= namaKafe %></span>
          <span class="admin-brand__app">Panel Admin</span>
        </span>
      </a>
      <%# Tombol tutup hanya tampil saat sidebar menjadi laci %>
      <button class="admin-sidebar__tutup" type="button" data-admin-tutup aria-label="Tutup navigasi admin">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <%# Tautan utama area admin dengan ikon agar mudah dipindai %>
    <nav class="admin-menu" aria-label="Navigasi admin">
      <p class="admin-menu__label">Kelola</p>
      <a class="admin-menu__link" href="/admin"<% if (tabAdminAwal === 'produk') { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <span>Menu Utama</span>
      </a>
      <a class="admin-menu__link" href="/admin/foto"<% if (tabAdminAwal === 'foto') { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3.5" y="5" width="17" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" />
          <circle cx="9" cy="10" r="1.5" fill="currentColor" />
          <path d="m5.5 16 4.2-4.2 3.1 3.1 2.4-2.4 3.3 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Galeri Foto</span>
      </a>
      <a class="admin-menu__link" href="/admin/video"<% if (tabAdminAwal === 'video') { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" />
          <path d="m10 8.5 5.5 3.5-5.5 3.5v-7Z" fill="currentColor" />
        </svg>
        <span>Video</span>
      </a>
      <a class="admin-menu__link" href="/admin/caption"<% if (tabAdminAwal === 'caption') { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m12 4 1.7 4.3L18 10l-4.3 1.7L12 16l-1.7-4.3L6 10l4.3-1.7L12 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M18.5 15.5 19.3 17l1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8.8-1.5Z" fill="currentColor" />
        </svg>
        <span>AI Caption</span>
      </a>
    </nav>

    <%# Tautan situs publik dan tombol keluar ditempatkan di kaki sidebar %>
    <div class="admin-sidebar__foot">
      <a class="admin-menu__link" href="/">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 5h5v5M19 5l-8 8M11 5H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Lihat situs</span>
      </a>
      <%# Keluar memakai POST agar tidak dapat dipicu tautan GET %>
      <form method="post" action="/admin/logout">
        <button class="admin-keluar" type="submit">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-2M10 12h10m0 0-3-3m3 3-3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Keluar</span>
        </button>
      </form>
    </div>
  </aside>

  <%# Lapisan gelap menutup laci saat diketuk pada layar kecil %>
  <div class="admin-scrim" data-admin-scrim hidden></div>

  <div class="admin-main">
    <header class="admin-topbar">
      <button class="admin-topbar__toggle" type="button" data-admin-toggle aria-controls="admin-sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Buka navigasi admin</span>
      </button>
      <p class="admin-topbar__judul"><%= labelTab %></p>
      <span class="admin-topbar__badge">Admin</span>
    </header>
    <main class="admin-konten" id="konten" tabindex="-1">
