<%# Halaman daftar produk: seluruh baris berasal dari database %>
<%- include('../partials/admin-awal', { judul, tabAktif }) %>
  <%# Kepala halaman tanpa label hiasan: hanya judul, jumlah data, dan aksi %>
  <header class="max-w-3xl">
    <h1 class="section-head__title">Kelola menu Bura Bura.</h1>
    <%# Jumlah data dan tombol menuju form tambah %>
    <p class="section-head__meta"><%= jumlahProduk %> produk tersimpan di database</p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a class="btn btn--primary" href="/admin/tambah">Tambah Menu</a>
    </div>
  </header>

  <%# Kotak pesan sukses yang diisi oleh JavaScript %>
  <div id="pesan-sukses" class="crud-alert crud-alert--sukses hidden" role="status" aria-live="polite"></div>
  <%# Kotak pesan gagal untuk operasi hapus %>
  <div id="pesan-galat" class="crud-alert crud-alert--galat hidden" role="alert"></div>

  <%# Keadaan kosong bila database belum berisi produk %>
  <% if (daftarProduk.length === 0) { %>
    <div class="crud-empty mt-10">
      <p class="kicker justify-center">Belum ada data</p>
      <h2 class="mt-3" style="font-family: var(--display); font-size: 1.5rem;">Daftar masih kosong</h2>
      <p class="crud-muted mt-2">Tambahkan produk pertama untuk mulai mengisi menu.</p>
      <a class="btn btn--primary mt-6" href="/admin/tambah">Tambah Menu</a>
    </div>
  <% } else { %>
    <%# Tabel untuk layar sedang dan besar %>
    <div class="crud-card mt-8 hidden md:block">
      <table class="crud-table">
        <%# Kepala tabel memakai label kecil berhuruf kapital %>
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Foto</th>
            <th scope="col">Produk</th>
            <th scope="col">Kategori</th>
            <th scope="col">Harga</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <%# Satu baris untuk setiap produk dari database %>
          <% daftarProduk.forEach(function (produk) { %>
            <tr>
              <%# Nomor id produk %>
              <td class="crud-muted"><%= produk.id %></td>
              <%# Gambar mini dengan placeholder inisial bila foto kosong %>
              <td>
                <div class="crud-thumb">
                  <span class="crud-thumb__placeholder" aria-hidden="true"><%= ambilInisial(produk.nama) %></span>
                  <% if (produk.foto) { %>
                    <img src="<%= produk.foto %>" alt="Foto <%= produk.nama %>" width="54" height="54" loading="lazy" decoding="async" onerror="this.hidden=true" />
                  <% } %>
                </div>
              </td>
              <%# Nama dan deskripsi singkat produk %>
              <td>
                <p class="crud-name"><%= produk.nama %></p>
                <p class="crud-muted mt-1 max-w-xs"><%= produk.deskripsi ? produk.deskripsi : 'Tanpa deskripsi.' %></p>
              </td>
              <%# Kategori produk dari database %>
              <td class="crud-muted"><%= produk.kategori %></td>
              <%# Harga utama atau rentang harga %>
              <td class="crud-price"><%= formatRentangHarga(produk.harga, produk.hargaMaks) %></td>
              <%# Lencana status ketersediaan %>
              <td>
                <% if (produk.tersedia) { %>
                  <span class="crud-badge crud-badge--online">Tersedia</span>
                <% } else { %>
                  <span class="crud-badge crud-badge--offline">Habis</span>
                <% } %>
              </td>
              <%# Tombol ubah dan hapus per baris %>
              <td>
                <div class="flex justify-end gap-2">
                  <a class="crud-btn" href="/admin/<%= produk.id %>/ubah">Ubah</a>
                  <button class="crud-btn crud-btn--danger" type="button" data-hapus data-id="<%= produk.id %>" data-nama="<%= produk.nama %>">Hapus</button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%# Kartu produk untuk layar kecil %>
    <div class="mt-8 space-y-3 md:hidden">
      <% daftarProduk.forEach(function (produk) { %>
        <article class="crud-card-item">
          <%# Identitas dan status produk %>
          <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-start gap-3">
              <%# Gambar mini produk pada tampilan kartu %>
              <div class="crud-thumb crud-thumb--small">
                <span class="crud-thumb__placeholder" aria-hidden="true"><%= ambilInisial(produk.nama) %></span>
                <% if (produk.foto) { %>
                  <img src="<%= produk.foto %>" alt="Foto <%= produk.nama %>" width="44" height="44" loading="lazy" decoding="async" onerror="this.hidden=true" />
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="crud-muted">#<%= produk.id %></p>
                <h2 class="crud-name mt-1"><%= produk.nama %></h2>
              </div>
            </div>
            <% if (produk.tersedia) { %>
              <span class="crud-badge crud-badge--online">Tersedia</span>
            <% } else { %>
              <span class="crud-badge crud-badge--offline">Habis</span>
            <% } %>
          </div>
          <%# Kategori, deskripsi, dan harga produk %>
          <p class="crud-muted mt-2 uppercase tracking-wide"><%= produk.kategori %></p>
          <p class="crud-muted mt-2"><%= produk.deskripsi ? produk.deskripsi : 'Tanpa deskripsi.' %></p>
          <p class="crud-price mt-3"><%= formatRentangHarga(produk.harga, produk.hargaMaks) %></p>
          <%# Aksi ubah dan hapus pada tampilan kartu %>
          <div class="mt-4 flex gap-2">
            <a class="crud-btn flex-1" href="/admin/<%= produk.id %>/ubah">Ubah</a>
            <button class="crud-btn crud-btn--danger flex-1" type="button" data-hapus data-id="<%= produk.id %>" data-nama="<%= produk.nama %>">Hapus</button>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
<%# JavaScript sisi klien untuk tombol hapus dan pesan sukses %>
<%- include('../partials/admin-akhir', { skrip: 'produk' }) %>