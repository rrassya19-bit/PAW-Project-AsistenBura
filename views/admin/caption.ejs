<%# Halaman chat caption AI khusus admin %>
<%- include('../partials/admin-awal', { judul, tabAktif, kelasKonten: 'admin-konten--caption' }) %>
<section class="caption-chat" data-caption-chat aria-label="Chat AI Caption">
  <%# Bilah atas kecil berisi judul dan tombol percakapan baru %>
  <header class="caption-chat__bar">
    <h1 class="caption-chat__judul">AI Caption</h1>
    <button class="caption-chat__reset" type="button" data-caption-reset>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Percakapan baru</span>
    </button>
  </header>

  <%# Daftar pesan menjadi satu-satunya area yang bergulir %>
  <div class="caption-chat__log" data-caption-log role="log" aria-live="polite" aria-relevant="additions">
    <div class="caption-chat__baris caption-chat__baris--asisten" data-caption-awal>
      <div class="caption-chat__avatar" aria-hidden="true">B</div>
      <div class="caption-chat__balon">
        <p>Unggah foto dan tulis permintaanmu. Aku bantu buatkan caption.</p>
        <div class="caption-chat__chip-grup" data-caption-chip-awal>
          <button class="caption-chat__chip" type="button" data-caption-chip data-isi="Caption santai untuk Instagram">Caption santai untuk Instagram</button>
          <button class="caption-chat__chip" type="button" data-caption-chip data-isi="Satu kalimat singkat">Satu kalimat singkat</button>
          <button class="caption-chat__chip" type="button" data-caption-chip data-isi="Ajakan berkunjung">Ajakan berkunjung</button>
          <button class="caption-chat__chip" type="button" data-caption-chip data-isi="Versi bahasa Inggris">Versi bahasa Inggris</button>
        </div>
      </div>
    </div>
  </div>

  <%# Composer menempel di bawah dan tidak ikut bergulir %>
  <form class="caption-chat__form" data-caption-form novalidate>
    <div class="caption-chat__form-isi">
      <div class="caption-chat__lampiran" data-caption-lampiran hidden>
        <div class="caption-chat__lampiran-kartu">
          <img class="caption-chat__lampiran-gambar" data-caption-thumb alt="" width="40" height="40" />
          <span class="caption-chat__lampiran-nama" data-caption-nama></span>
          <button class="caption-chat__lampiran-hapus" type="button" data-caption-hapus aria-label="Hapus gambar">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div class="caption-chat__kotak">
        <input class="visually-hidden" id="caption-gambar" type="file" accept="image/jpeg,image/png,image/webp" data-caption-file tabindex="-1" aria-hidden="true" />
        <button class="caption-chat__ikon" type="button" data-caption-attach aria-label="Lampirkan foto" title="Lampirkan foto">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 12.5 12.7 19.8a4.5 4.5 0 0 1-6.4-6.4l8.2-8.2a3 3 0 0 1 4.3 4.3l-8.2 8.2a1.5 1.5 0 0 1-2.1-2.1l7.5-7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <textarea class="caption-chat__input" id="caption-input" rows="1" maxlength="500" placeholder="Tulis permintaan caption..." data-caption-input></textarea>
        <button class="caption-chat__kirim" type="submit" data-caption-send aria-label="Kirim permintaan" title="Kirim permintaan" disabled>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m5 12 14-7-4.5 14-3-5.5L5 12Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <p class="caption-chat__galat" data-caption-error role="alert" hidden></p>
    </div>
  </form>

  <%# Lapisan petunjuk saat gambar diseret ke halaman %>
  <div class="caption-chat__drop" data-caption-drop hidden aria-hidden="true">
    <div class="caption-chat__drop-kartu">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p>Lepaskan gambar di sini</p>
    </div>
  </div>
</section>
<%- include('../partials/admin-akhir', { skrip: 'caption' }) %>
