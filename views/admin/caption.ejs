<%# Halaman AI caption khusus admin untuk foto dan video %>
<%- include('../partials/admin-awal', { judul, tabAktif }) %>
<%
  // Seluruh media digabung untuk menentukan keadaan kosong halaman
  const totalMediaCaption = daftarFoto.length + daftarVideo.length;
%>
  <header class="max-w-3xl">
    <p class="kicker">AI Caption</p>
    <h1 class="section-head__title">Buat caption untuk galeri.</h1>
    <p class="section-head__meta">Pilih foto atau video, tambahkan catatan bila perlu, lalu minta tiga saran caption dari AI. Caption yang dipilih dapat langsung disimpan.</p>
  </header>

  <%# Keadaan kosong bila belum ada media yang dapat diberi caption %>
  <% if (totalMediaCaption === 0) { %>
    <div class="crud-empty mt-10">
      <h2 style="font-family: var(--display); font-size: 1.5rem;">Belum ada media.</h2>
      <p class="crud-muted mt-2">Tambahkan foto atau video terlebih dahulu untuk memakai AI caption.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a class="btn btn--primary" href="/admin/foto/tambah">Tambah Foto</a>
        <a class="btn btn--outline" href="/admin/video/tambah">Tambah Video</a>
      </div>
    </div>
  <% } else { %>
    <%
      // Setiap jenis dirender pada bagiannya sendiri agar mudah dipindai
      const bagianCaption = [
        ['foto', 'Foto', daftarFoto],
        ['video', 'Video', daftarVideo],
      ];
    %>
    <% bagianCaption.forEach(function (bagian) { %>
      <%
        const jenisCaption = bagian[0];
        const labelCaption = bagian[1];
        const daftarCaption = bagian[2];
      %>
      <% if (daftarCaption.length > 0) { %>
        <section class="mt-10" aria-labelledby="judul-caption-<%= jenisCaption %>">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 id="judul-caption-<%= jenisCaption %>" style="font-family: var(--display); font-size: 1.6rem;"><%= labelCaption %></h2>
              <p class="crud-muted mt-1"><%= daftarCaption.length %> <%= jenisCaption %> siap diberi caption.</p>
            </div>
          </div>

          <div class="mt-6 grid gap-5 lg:grid-cols-2">
            <% daftarCaption.forEach(function (item) { %>
              <article
                class="crud-card"
                data-caption-kartu
                data-id="<%= item.id %>"
                data-jenis="<%= jenisCaption %>"
                data-judul="<%= item.judul %>"
                data-urutan="<%= item.urutan %>"
                data-hero="<%= item.hero ? 'true' : 'false' %>"
              >
                <%# Thumbnail foto atau elemen video tanpa autoplay %>
                <div class="relative w-full overflow-hidden" style="aspect-ratio: 4 / 3; background: var(--paper-soft);">
                  <% if (jenisCaption === 'foto') { %>
                    <img class="h-full w-full object-cover" src="<%= item.berkas %>" alt="<%= item.judul %>" width="600" height="450" loading="lazy" decoding="async" />
                  <% } else { %>
                    <%
                      // Tipe sumber video dipilih dari ekstensi berkas
                      const tipeVideoCaption = item.berkas.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4';
                    %>
                    <video class="h-full w-full object-cover" muted playsinline preload="metadata" aria-label="<%= item.judul %>">
                      <source src="<%= item.berkas %>" type="<%= tipeVideoCaption %>" />
                    </video>
                  <% } %>
                </div>

                <div class="p-5">
                  <%# Identitas media dan tautan menuju form ubah %>
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="crud-name"><%= item.judul %></h3>
                        <span class="crud-badge crud-badge--online"><%= labelCaption %></span>
                        <% if (jenisCaption === 'foto' && item.hero) { %>
                          <span class="crud-badge crud-badge--online">Hero</span>
                        <% } %>
                      </div>
                      <p class="crud-muted mt-1">Urutan <%= item.urutan %></p>
                    </div>
                    <a class="crud-btn" href="/admin/<%= jenisCaption %>/<%= item.id %>/ubah">Ubah detail</a>
                  </div>

                  <%# Kolom caption yang dapat diisi dari saran AI atau ditulis manual %>
                  <label class="crud-label mt-4" for="caption-<%= jenisCaption %>-<%= item.id %>">Caption</label>
                  <textarea
                    class="crud-input"
                    id="caption-<%= jenisCaption %>-<%= item.id %>"
                    rows="3"
                    maxlength="300"
                    placeholder="Tulis caption singkat untuk media ini"
                    data-caption-area
                  ><%= item.caption %></textarea>

                  <%# Catatan opsional menjadi konteks tambahan untuk model %>
                  <label class="crud-label mt-3" for="catatan-<%= jenisCaption %>-<%= item.id %>">Catatan untuk AI (opsional)</label>
                  <input
                    class="crud-input"
                    id="catatan-<%= jenisCaption %>-<%= item.id %>"
                    type="text"
                    maxlength="200"
                    placeholder="Contoh: suasana pagi, tanpa menyebut harga"
                    data-caption-catatan
                  />

                  <div class="mt-4 flex flex-wrap gap-2">
                    <button class="btn btn--ghost" type="button" data-caption-ai>Buat caption dengan AI</button>
                    <button class="btn btn--primary" type="button" data-caption-simpan>Simpan caption</button>
                  </div>

                  <%# Status dan hasil AI diisi oleh skrip halaman %>
                  <p class="caption-saran__info mt-3 hidden" data-caption-status role="status" aria-live="polite"></p>
                  <div class="caption-saran__wadah hidden" data-caption-hasil aria-live="polite"></div>
                </div>
              </article>
            <% }); %>
          </div>
        </section>
      <% } %>
    <% }); %>
  <% } %>
<%# Skrip halaman untuk membuat dan menyimpan caption %>
<%- include('../partials/admin-akhir', { skrip: 'caption' }) %>
