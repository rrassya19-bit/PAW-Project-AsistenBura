<%# Halaman form: dipakai untuk tambah dan ubah produk %>
<%- include('../partials/admin-awal', { judul, tabAktif }) %>
  <div class="max-w-3xl">
    <%# Tautan kecil kembali ke daftar produk %>
    <a class="crud-muted inline-flex items-center gap-2" href="/admin">
      <span aria-hidden="true">&larr;</span> Kembali ke daftar
    </a>

    <%# Judul menyesuaikan mode tambah atau ubah, tanpa label hiasan %>
    <header class="mt-5">
      <h1 style="font-family: var(--display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; line-height: 1; letter-spacing: -0.04em;">
        <%= mode === 'ubah' ? 'Ubah Produk' : 'Tambah Produk' %>
      </h1>
    </header>

    <%# Kotak kesalahan validasi dari API, awalnya tersembunyi %>
    <div id="kesalahan-validasi" class="crud-alert crud-alert--galat hidden" role="alert">
      <p data-pesan-utama class="font-semibold">Validasi gagal</p>
      <ul id="daftar-kesalahan" class="mt-2 list-disc space-y-1 pl-5"></ul>
    </div>

    <%# Form dikirim lewat fetch oleh partial scripts/produk.ejs %>
    <form id="form-produk" data-mode="<%= mode %>" data-id="<%= produk ? produk.id : '' %>" class="crud-card mt-8 p-5 sm:p-8">
      <div class="space-y-6">
        <%# Input nama produk %>
        <div>
          <label class="crud-label" for="nama">Nama produk</label>
          <input class="crud-input" id="nama" name="nama" type="text" maxlength="100" required autocomplete="off" value="<%= produk ? produk.nama : '' %>" placeholder="Contoh: Dirty Latte">
          <p class="crud-muted mt-2">Wajib diisi, maksimal 100 karakter.</p>
        </div>

        <%# Input kategori dengan saran dari kategori yang sudah ada %>
        <div>
          <label class="crud-label" for="kategori">Kategori</label>
          <input class="crud-input" id="kategori" name="kategori" type="text" maxlength="50" required autocomplete="off" list="daftar-kategori" value="<%= produk ? produk.kategori : '' %>" placeholder="Contoh: Coffee Milk Based">
          <p class="crud-muted mt-2">Pilih kategori yang ada atau ketik kategori baru.</p>
          <%# Datalist berisi kategori unik dari database %>
          <datalist id="daftar-kategori">
            <% daftarKategori.forEach(function (kategori) { %>
              <option value="<%= kategori %>"></option>
            <% }); %>
          </datalist>
        </div>

        <%# Harga utama dan harga maksimum opsional %>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label class="crud-label" for="harga">Harga</label>
            <input class="crud-input" id="harga" name="harga" type="number" min="0" step="1" required value="<%= produk ? produk.harga : '' %>" placeholder="35000">
            <p class="crud-muted mt-2">Bilangan bulat minimal 0.</p>
          </div>
          <div>
            <label class="crud-label" for="hargaMaks">Harga maksimum <span class="font-normal">(opsional)</span></label>
            <input class="crud-input" id="hargaMaks" name="hargaMaks" type="number" min="0" step="1" value="<%= produk && produk.hargaMaks !== null ? produk.hargaMaks : '' %>" placeholder="Kosongkan bila tidak ada rentang">
            <p class="crud-muted mt-2">Harus lebih besar atau sama dengan harga utama.</p>
          </div>
        </div>

        <%# Deskripsi opsional %>
        <div>
          <label class="crud-label" for="deskripsi">Deskripsi <span class="font-normal">(opsional)</span></label>
          <textarea class="crud-input" id="deskripsi" name="deskripsi" rows="4" placeholder="Bahan atau catatan singkat tentang produk"><%= produk ? produk.deskripsi : '' %></textarea>
        </div>

        <%# Foto menu opsional berupa path /media atau URL https %>
        <div>
          <label class="crud-label" for="foto">Foto <span class="font-normal">(opsional)</span></label>
          <input class="crud-input" id="foto" name="foto" type="text" maxlength="255" autocomplete="off" value="<%= produk && produk.foto ? produk.foto : '' %>" placeholder="/media/menu/espresso.jpg">
          <p class="crud-muted mt-2">Gunakan path <code>/media/menu/nama-menu.jpg</code> atau URL <code>https://...</code>.</p>
          <%# Pratinjau foto diisi oleh skrip admin tanpa menampilkan ikon gambar rusak %>
          <img id="pratinjau-foto" class="crud-foto-preview mt-3" alt="Pratinjau foto produk" width="320" height="240" hidden />
        </div>

        <%# Status ketersediaan produk %>
        <div class="crud-check">
          <input id="tersedia" name="tersedia" type="checkbox" <%= !produk || produk.tersedia ? 'checked' : '' %>>
          <div>
            <label class="crud-label mb-0" for="tersedia">Produk tersedia</label>
            <p class="crud-muted">Hilangkan centang bila produk sedang habis.</p>
          </div>
        </div>
      </div>

      <%# Tombol simpan dan batal %>
      <div class="mt-8 flex flex-col gap-3 border-t pt-6 sm:flex-row sm:items-center sm:justify-end" style="border-color: var(--line);">
        <a class="btn btn--outline" href="/admin">Batal</a>
        <button id="tombol-simpan" class="btn btn--primary" type="submit">
          <%= mode === 'ubah' ? 'Simpan perubahan' : 'Simpan produk' %>
        </button>
      </div>
    </form>
  </div>
<%# JavaScript sisi klien untuk mengirim form lewat fetch %>
<%- include('../partials/admin-akhir', { skrip: 'produk' }) %>