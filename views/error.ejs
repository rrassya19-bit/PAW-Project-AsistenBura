<%# Halaman error: ditampilkan ketika terjadi kesalahan pada server %>
<%- include('partials/head', { judul }) %>
<%- include('partials/navbar') %>
<%# Wadah utama memakai lebar shell dan jarak atas untuk header tetap %>
<main id="konten" class="shell pt-32 pb-24">
  <div class="crud-empty mx-auto max-w-2xl">
    <%# Kode status kesalahan %>
    <p class="kicker justify-center">Kesalahan server</p>
    <p class="mt-4" style="font-family: var(--display); font-size: clamp(4rem, 12vw, 7rem); font-weight: 500; line-height: 0.9; letter-spacing: -0.05em; color: var(--cobalt);"><%= status %></p>
    <h1 class="mt-4" style="font-family: var(--display); font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 500; letter-spacing: -0.03em;">Terjadi kesalahan</h1>
    <%# Pesan ramah yang tidak membocorkan detail internal %>
    <p class="crud-muted mx-auto mt-3 max-w-md"><%= pesan %></p>
    <%# Tombol menuju beranda dan daftar produk %>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn--primary" href="/">Ke beranda</a>
      <a class="btn btn--outline" href="/produk">Lihat produk</a>
    </div>
  </div>
</main>
<%- include('partials/footer') %>