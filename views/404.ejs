<%# Halaman 404: ditampilkan untuk alamat yang tidak dikenal %>
<%- include('partials/head', { judul }) %>
<%- include('partials/navbar', { halaman }) %>
<main id="konten" class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6">
  <%# Angka besar sebagai penanda halaman tidak ditemukan %>
  <p class="font-display text-7xl font-semibold text-karamel sm:text-8xl">404</p>
  <h1 class="mt-4 font-display text-3xl font-semibold text-espresso sm:text-4xl">Halaman tidak ditemukan</h1>
  <p class="mt-3 max-w-md text-sm leading-relaxed text-kopi">
    Alamat yang Anda buka tidak tersedia. Periksa kembali tautan atau kembali ke halaman utama.
  </p>
  <%# Tombol menuju beranda dan daftar produk %>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a href="/" class="rounded-full bg-espresso px-5 py-3 text-sm font-semibold text-krem transition hover:bg-kopi focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aksen">
      Ke beranda
    </a>
    <a href="/produk" class="rounded-full border border-espresso/20 px-5 py-3 text-sm font-semibold text-espresso transition hover:bg-kremTua focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aksen">
      Lihat produk
    </a>
  </div>
</main>
<%- include('partials/footer') %>
